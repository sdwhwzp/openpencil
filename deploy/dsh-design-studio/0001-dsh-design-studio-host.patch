+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtempSync, mkdirSync, readFileSync, realpathSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { randomUUID } from 'node:crypto';
+import { DesignStudio, type DesignBoard } from '../src/design-studio.js';
+import type { AuthenticatedPrincipal } from '../src/principal.js';
+import { HostTaskLedger, TaskBoardHostService } from '../dist/task-board-engine.js';
+
+test('drawing revisions are scoped, immutable on handoff, and start one writable board execution per revision', async t => {
+  const root = realpathSync(mkdtempSync(path.join(tmpdir(), 'dsh-design-test-')));
+  const project = { id: 'test-project', title: '测试项目', path: path.join(root, 'project') };
+  mkdirSync(project.path);
+  const ledger = new HostTaskLedger(path.join(root, 'board'));
+  const calls: string[] = [];
+  const service = new TaskBoardHostService({ invoke: async request => {
+    calls.push(`${request.namespace}/${request.method}`);
+    if (request.method === 'create') return { sessionId: 'design-session' };
+    return {};
+  }, stream: async () => ({ async *[Symbol.asyncIterator]() {} }) }, { ledger, commandDispatcher: { execute: async () => ({}) } });
+  const user = { id: '1', role: 'user', username: 'designer', source: 'dsh-passwords' } as const;
+  const other = { ...user, id: '2' };
+  const access = async (actor: typeof user | typeof other) => ({ board: service as unknown as DesignBoard, projects: [project], writable: actor.id === '1' });
+  const studio = new DesignStudio(root, access);
+  t.after(() => { service.dispose(); studio.close(); rmSync(root, { recursive: true, force: true }); });
+  const key = { workspace: project.id, id: randomUUID() };
+  const call = (action: string, args = {}) => studio.action(user, { ...key, action, ...args }) as Promise<Record<string, any>>;
+  const fresh = await call('new');
+  const blank = { ...fresh.draft, brief: '在 /devices 实现该页', title: '设备列表' };
+  await assert.rejects(call('deliver', blank), /添加设计内容/);
+  const input = { ...blank, document: JSON.stringify({ version: '1.0.0', children: [{ type: 'rectangle', id: 'button', width: 120, height: 40 }] }) };
+  await assert.rejects(studio.action(other, { ...key, action: 'open' }), /没有找到/);
+  await assert.rejects(studio.action(other, { ...key, ...input, action: 'new' }), /没有项目写入权限/);
+  await assert.rejects(call('list', { workspace: 'unassigned' }), /没有此工作区/);
+  const saved = await call('save', input);
+  assert.equal(saved.revision, 2);
+  assert.equal(calls.length, 0);
+  await assert.rejects(call('save', { ...input, title: '旧标签' }), /另一页面/);
+  const [first, second] = await Promise.all([call('deliver', input), call('deliver', input)]);
+  const id = first.deliveries[0].id;
+  assert.equal(first.deliveries[0].state, 'started', first.deliveries[0].error);
+  assert.equal(second.deliveries[0].id, id);
+  const preview = await studio.action(other, { action: 'preview', workspace: project.id, delivery: id }) as { design: { document: string } };
+  assert.equal(preview.design.document, input.document);
+  await assert.rejects(call('preview', { delivery: id, workspace: 'unassigned' }), /没有此工作区/);
+  assert.equal(readFileSync(path.join(project.path, `dsh-design-${id}.op`), 'utf8'), input.document);
+  const card = (service as unknown as DesignBoard).snapshot().tasks[0];
+  assert.equal(card.executions.length, 1);
+  assert.equal(card.permission, 'workspace-write');
+  assert.equal(card.workspaceId, project.id);
+  assert.match(card.prompt, /\/devices/);
+  for (let attempt = 0; attempt < 20 && !calls.includes('session/create'); attempt++) await new Promise(resolve => setTimeout(resolve, 5));
+  assert.equal(calls.filter(call => call === 'session/create').length, 1);
+  studio.close();
+  await studio.recover();
+  const reopened = await call('open');
+  assert.equal(reopened.draft.document, input.document);
+  assert.equal(reopened.deliveries.length, 1);
+});
+
+test('imports create one editable private draft and wait for explicit delivery', async t => {
+  const root = realpathSync(mkdtempSync(path.join(tmpdir(), 'dsh-figma-test-')));
+  const project = { id: 'figma-test', title: '设计', path: root };
+  const owner = { id: '1', role: 'user', username: 'designer', source: 'dsh-passwords' } as const;
+  const viewer = { ...owner, id: '2' };
+  const board: DesignBoard = { snapshot: () => ({ tasks: [] }), apply: () => assert.fail('unexpected task') };
+  const studio = new DesignStudio(root, async actor => ({ board, projects: [project], writable: actor.id === owner.id }));
+  t.after(() => { studio.close(); rmSync(root, { recursive: true, force: true }); });
+  const call = (action: string, args = {}, actor: AuthenticatedPrincipal = owner) =>
+    studio.action(actor, { workspace: project.id, action, ...args }) as Promise<{ draft: { title: string; document: string; revision: number }; drafts: { id: string }[] }>;
+  const id = randomUUID();
+  const document = JSON.stringify({ version: '1.0.0', pages: [{ name: '首页', children: [{ id: 'logo', type: 'rectangle' }] }] });
+  const input = { id, title: '商户端', document };
+  const existingId = randomUUID();
+  const existing = await call('new', { id: existingId });
+  await assert.rejects(call('import', input, viewer), /写入权限/);
+  await assert.rejects(call('import', { ...input, document: 'invalid' }), /有效的 JSON/);
+  assert.deepEqual((await call('list')).drafts.map(draft => draft.id), [existingId]);
+  const imported = await call('import', input);
+  assert.equal(imported.draft.revision, 1);
+  assert.equal(imported.draft.document, document);
+  assert.deepEqual((await call('import', input)).draft, imported.draft);
+  await assert.rejects(call('import', { ...input, id: existingId }), /已有其他设计稿/);
+  assert.deepEqual((await call('open', { id: existingId })).draft, existing.draft);
+  await assert.rejects(call('open', { id }, viewer), /没有找到设计稿/);
+  await call('save', { ...input, title: '商户端第二稿', brief: '', revision: imported.draft.revision });
+  assert.equal((await call('open', { id })).draft.title, '商户端第二稿');
+});
