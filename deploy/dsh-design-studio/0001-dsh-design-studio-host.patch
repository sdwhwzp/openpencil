+import { createHash } from 'node:crypto';
+import { execFileSync } from 'node:child_process';
+import { cpSync, mkdtempSync, mkdirSync, readFileSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const dest = fileURLToPath(new URL('../dist/design-runtime/', import.meta.url));
+function stage(spec, hash, input, member, output) {
+  const staging = mkdtempSync(path.join(tmpdir(), 'dsh-design-assets-'));
+  try {
+  let archive = input;
+  if (!archive) {
+    const json = execFileSync('npm', ['pack', spec, '--ignore-scripts', '--json', '--registry=https://registry.npmjs.org', '--pack-destination', staging], { encoding: 'utf8' });
+    archive = path.join(staging, JSON.parse(json)[0].filename);
+  }
+  if (createHash('sha512').update(readFileSync(archive)).digest('hex') !== hash) throw new Error('OpenPencil package integrity mismatch: ' + spec);
+  execFileSync('tar', ['-xzf', archive, '-C', staging, member, 'package/LICENSE', 'package/THIRD_PARTY_NOTICES.md']);
+  mkdirSync(output, { recursive: true });
+  cpSync(path.join(staging, member), output, { recursive: true });
+  for (const name of ['LICENSE', 'THIRD_PARTY_NOTICES.md']) cpSync(path.join(staging, 'package', name), path.join(output, name));
+  } finally { rmSync(staging, { recursive: true, force: true }); }
+}
