diff --git a/src/design-studio.ts b/src/design-studio.ts
new file mode 100644
index 0000000..ae018f5
--- /dev/null
+++ b/src/design-studio.ts
@@ -0,0 +1,226 @@
+import { createHash, randomUUID } from 'node:crypto';
+import { constants, closeSync, fstatSync, linkSync, mkdirSync, openSync, readFileSync, realpathSync, statSync, unlinkSync, writeFileSync } from 'node:fs';
+import path from 'node:path';
+import { DatabaseSync } from 'node:sqlite';
+import type { IncomingMessage, ServerResponse } from 'node:http';
+import type { AuthenticatedPrincipal } from './principal.js';
+
+type Fields = Record<string, unknown>;
+type Project = { id: string; title: string; path: string };
+type Card = {
+  id: string; title: string; prompt: string; workspaceId?: string; permission?: string;
+  parentId?: string; handover?: unknown; archivedAt?: number; status: string;
+  executions: { sessionId?: string; error?: string; summary?: string }[];
+};
+export interface DesignBoard {
+  snapshot(): { tasks: Card[] };
+  apply(requestId: string, action:
+    | { kind: 'create'; id: string; input: { title: string; description: string; prompt: string; workspaceId: string; permission: 'workspace-write' } }
+    | { kind: 'run' | 'confirm-permission'; taskId: string }): unknown;
+}
+interface Access { projects: readonly Project[]; board: DesignBoard; writable: boolean }
+interface Draft { id: string; title: string; brief: string; document: string; revision: number }
+interface Delivery { id: string; owner: string; workspace: string; draft: string; revision: number; title: string; brief: string; document: string; state: string; error: string | null }
+export const designLimit = 16 * 1024 * 1024;
+const blank = '{"version":"1.0.0","children":[],"pages":[{"id":"page-1","name":"页面 1","children":[]}]}';
+
+class DesignError extends Error {
+  constructor(readonly status: number, message: string) { super(message); }
+}
+const invalid = (message: string): never => { throw new DesignError(400, message); };
+function text(value: unknown, limit: number, label: string): string {
+  if (typeof value !== 'string' || value.length > limit) return invalid(`${label}格式无效`);
+  return value.trim();
+}
+function documentText(value: unknown): string {
+  if (typeof value !== 'string' || Buffer.byteLength(value) > designLimit) return invalid('设计稿超过大小限制');
+  let doc;
+  try { doc = JSON.parse(value); } catch { return invalid('设计稿不是有效的 JSON'); }
+  if (!doc || typeof doc.version !== 'string' || (!Array.isArray(doc.children) && !Array.isArray(doc.pages))) return invalid('需要有效的 OpenPencil 设计稿');
+  return JSON.stringify(doc);
+}
+function fingerprint(value: string): string { return createHash('sha256').update(value).digest('hex'); }
+
+function materialize(project: Project, file: string, document: string, dataRoot: string): void {
+  if (!path.isAbsolute(project.path) || realpathSync(project.path) !== project.path) throw new DesignError(409, '项目目录已变更，请重新选择');
+  const rootFd = openSync(project.path, constants.O_RDONLY | constants.O_DIRECTORY | constants.O_NOFOLLOW);
+  try {
+    if (fstatSync(rootFd).dev !== statSync(dataRoot).dev) throw new DesignError(403, '请选择位于工作区数据盘的项目');
+    const root = process.platform === 'linux' ? `/proc/self/fd/${rootFd}` : project.path;
+    const target = path.join(root, file);
+    const temporary = path.join(root, `.dsh-design-${randomUUID()}.tmp`);
+    writeFileSync(temporary, document, { flag: 'wx', mode: 0o644 });
+    try {
+      try { linkSync(temporary, target); } catch (err) {
+        if ((err as NodeJS.ErrnoException).code !== 'EEXIST') throw err;
+        const descriptor = openSync(target, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK);
+        try {
+          const existing = fstatSync(descriptor);
+          if (!existing.isFile() || existing.size !== Buffer.byteLength(document) || readFileSync(descriptor, 'utf8') !== document) {
+            throw new DesignError(409, '项目中的定稿文件已变更，请移走同名文件后重试');
+          }
+        } finally { closeSync(descriptor); }
+      }
+    } finally { unlinkSync(temporary); }
+  } finally { closeSync(rootFd); }
+}
+
+export class DesignStudio {
+  private store?: DatabaseSync;
+  constructor(private readonly dataRoot: string, private readonly access: (principal: AuthenticatedPrincipal, launch: boolean) => Promise<Access>) {}
+
+  private database(): DatabaseSync {
+    if (this.store) return this.store;
+    const directory = path.join(this.dataRoot, '.dsh-design-studio');
+    mkdirSync(directory, { recursive: true, mode: 0o700 });
+    const store = new DatabaseSync(path.join(directory, 'designs.sqlite'));
+    store.exec(`PRAGMA journal_mode=WAL;
+      CREATE TABLE IF NOT EXISTS drafts (
+        owner TEXT NOT NULL, workspace TEXT NOT NULL, id TEXT NOT NULL, title TEXT NOT NULL,
+        brief TEXT NOT NULL, document TEXT NOT NULL, revision INTEGER NOT NULL,
+        PRIMARY KEY (owner,workspace,id));
+      CREATE TABLE IF NOT EXISTS deliveries (
+        id TEXT PRIMARY KEY, owner TEXT NOT NULL, workspace TEXT NOT NULL, draft TEXT NOT NULL,
+        revision INTEGER NOT NULL, title TEXT NOT NULL, brief TEXT NOT NULL, document TEXT NOT NULL,
+        state TEXT NOT NULL DEFAULT 'pending', error TEXT, principal TEXT NOT NULL);
+      CREATE INDEX IF NOT EXISTS delivery_history ON deliveries(owner,workspace,draft,revision);`);
+    this.store = store;
+    return store;
+  }
+  close(): void { this.store?.close(); this.store = undefined; }
+
+  async recover(): Promise<void> {
+    const databaseFile = path.join(this.dataRoot, '.dsh-design-studio', 'designs.sqlite');
+    try { statSync(databaseFile); } catch (err) {
+      if ((err as NodeJS.ErrnoException).code === 'ENOENT') return;
+      throw err;
+    }
+    const pending = this.database().prepare("SELECT id,principal FROM deliveries WHERE state='pending'").all();
+    for (const row of pending) {
+      try {
+        const access = await this.access(JSON.parse(String(row.principal)) as AuthenticatedPrincipal, true);
+        this.launch(String(row.id), access);
+      } catch (err) { this.recordFailure(String(row.id), err); }
+    }
+  }
+  private recordFailure(id: string, err: unknown): void {
+    const message = err instanceof Error ? err.message : '开发任务未启动';
+    this.database().prepare("UPDATE deliveries SET state='failed',error=? WHERE id=? AND state<>'started'").run(message.slice(0, 400), id);
+  }
+  private launch(id: string, access: Access): void {
+    const store = this.database();
+    const row = store.prepare('SELECT * FROM deliveries WHERE id=?').get(id) as unknown as Delivery;
+    if (row.state === 'started') return;
+    const project = access.projects.find(item => item.id === row.workspace);
+    if (!project || !access.writable) throw new DesignError(403, '当前账号没有此项目的开发权限');
+    const file = `dsh-design-${id}.op`;
+    const title = `设计开发 · ${row.title}`;
+    const prompt = `在当前业务项目中实现设计稿 ${file}。先读取这份 OpenPencil JSON（页面、图层、布局、文字、颜色和内嵌素材），再检查项目已有路由、组件和开发约定。按设计实现可运行的页面，执行该项目适用的构建或测试，并在会话中报告改动文件、核验结果及预览方式。保留原始定稿文件。\n\n美工的页面与交互说明：\n${row.brief || '根据设计稿和当前项目约定实现。'}`;
+    const card = access.board.snapshot().tasks.find(item => item.id === id);
+    if (card && (card.title !== title || card.prompt !== prompt || card.workspaceId !== project.id || card.permission !== 'workspace-write' || card.parentId || card.handover || card.archivedAt)) {
+      throw new DesignError(409, '交付任务已被修改，请在任务看板核对');
+    }
+    if (!card?.executions.length) {
+      materialize(project, file, row.document, this.dataRoot);
+      if (!card) access.board.apply(`${id}-create`, { kind: 'create', id, input: { title, description: `设计稿第 ${row.revision} 版`, prompt, workspaceId: project.id, permission: 'workspace-write' } });
+      access.board.apply(`${id}-confirm`, { kind: 'confirm-permission', taskId: id });
+      access.board.apply(`${id}-run`, { kind: 'run', taskId: id });
+    }
+    store.prepare("UPDATE deliveries SET state='started',error=NULL WHERE id=?").run(id);
+  }
+
+  async action(principal: AuthenticatedPrincipal, input: Fields): Promise<unknown> {
+    const access = await this.access(principal, input.action === 'deliver');
+    if (input.action === 'projects') return { projects: access.projects.map(({ id, title }) => ({ id, title })), writable: access.writable, maxDocumentBytes: designLimit };
+    const project = access.projects.find(row => row.id === input.workspace);
+    if (!project) throw new DesignError(403, '没有此工作区的访问权限');
+    const store = this.database();
+    const scope = [principal.id, project.id];
+    if (input.action === 'preview') {
+      const delivery = text(input.delivery, 32, '定稿版本');
+      const row = store.prepare('SELECT title,revision,document FROM deliveries WHERE id=? AND workspace=?').get(delivery, project.id);
+      if (!row) throw new DesignError(404, '没有找到这个定稿版本');
+      return { design: row };
+    }
+    if (input.action === 'list') return { drafts: store.prepare('SELECT id,title,revision FROM drafts WHERE owner=? AND workspace=? ORDER BY rowid DESC').all(...scope) };
+    const id = text(input.id, 64, '设计稿编号');
+    if (!/^[a-f0-9]{8}-[a-f0-9-]{27}$/.test(id)) return invalid('设计稿编号无效');
+    const key = [...scope, id];
+    const importing = input.action === 'import';
+    if (input.action === 'new' || importing) {
+      if (!access.writable) throw new DesignError(403, '此账号没有项目写入权限');
+      const title = importing ? text(input.title, 100, '设计名称') : '未命名设计';
+      if (!title) return invalid('请输入设计名称');
+      const document = importing ? documentText(input.document) : blank;
+      const inserted = store.prepare('INSERT OR IGNORE INTO drafts VALUES(?,?,?,?,?,?,1)').run(...key, title, '', document);
+      if (importing && !inserted.changes) {
+        const same = store.prepare('SELECT 1 FROM drafts WHERE owner=? AND workspace=? AND id=? AND title=? AND document=?').get(...key, title, document);
+        if (!same) throw new DesignError(409, '同一编号已有其他设计稿，请重新导入');
+      }
+    }
+    const read = () => store.prepare('SELECT id,title,brief,document,revision FROM drafts WHERE owner=? AND workspace=? AND id=?').get(...key) as unknown as Draft | undefined;
+    const draft = read();
+    if (!draft) throw new DesignError(404, '没有找到设计稿');
+    const history = () => {
+      const cards = access.board.snapshot().tasks;
+      return store.prepare('SELECT id,revision,state,error FROM deliveries WHERE owner=? AND workspace=? AND draft=? ORDER BY rowid DESC LIMIT 10').all(...key).map(row => {
+        const card = cards.find(item => item.id === row.id);
+        const execution = card?.executions.at(-1);
+        return { ...row, status: card?.status, sessionId: execution?.sessionId, result: execution?.summary ?? execution?.error };
+      });
+    };
+    if (input.action === 'open' || input.action === 'new' || importing) return { draft, deliveries: history() };
+    if (input.action === 'history') return { deliveries: history() };
+    if (!access.writable) throw new DesignError(403, '此账号没有项目写入权限');
+    if (input.action !== 'save' && input.action !== 'deliver') return invalid('未知操作');
+    const title = text(input.title, 100, '设计名称');
+    const brief = text(input.brief, 4000, '开发说明');
+    const document = documentText(input.document);
+    if (!title) return invalid('请输入设计名称');
+    const changed = title !== draft.title || brief !== draft.brief || document !== draft.document;
+    if (changed && draft.revision !== input.revision) throw new DesignError(409, '另一页面已保存新版本，请导出当前稿件并重新打开');
+    const revision = draft.revision + Number(changed);
+    if (input.action === 'deliver') {
+      const doc = JSON.parse(document);
+      if (!doc.children?.length && !doc.pages?.some((page: Fields) => Array.isArray(page?.children) && page.children.length)) return invalid('请先在画布中添加设计内容');
+    }
+    store.exec('BEGIN IMMEDIATE');
+    const task = fingerprint(JSON.stringify([principal.id, project.id, id, revision])).slice(0, 32);
+    try {
+      const latest = read();
+      if (latest?.revision !== draft.revision) throw new DesignError(409, '另一页面已保存新版本，请重新打开');
+      if (changed) store.prepare('UPDATE drafts SET title=?,brief=?,document=?,revision=? WHERE owner=? AND workspace=? AND id=?').run(title, brief, document, revision, ...key);
+      if (input.action === 'deliver') store.prepare('INSERT OR IGNORE INTO deliveries (id,owner,workspace,draft,revision,title,brief,document,principal) VALUES(?,?,?,?,?,?,?,?,?)').run(task, ...key, revision, title, brief, document, JSON.stringify(principal));
+      store.exec('COMMIT');
+    } catch (err) { store.exec('ROLLBACK'); throw err; }
+    if (input.action === 'deliver') {
+      try { this.launch(task, access); } catch (err) { this.recordFailure(task, err); }
+    }
+    return { revision, ...(input.action === 'deliver' ? { deliveries: history() } : {}) };
+  }
+}
+
+export async function designResponse(req: IncomingMessage, res: ServerResponse, studio: DesignStudio, principal: AuthenticatedPrincipal): Promise<void> {
+  res.setHeader('content-type', 'application/json; charset=utf-8');
+  res.setHeader('cache-control', 'no-store');
+  try {
+    if (req.method !== 'POST' || req.headers['x-dsh-design'] !== '1' || !req.headers['content-type']?.startsWith('application/json') ||
+        (req.headers['sec-fetch-site'] && req.headers['sec-fetch-site'] !== 'same-origin')) throw new DesignError(403, '需要从 DSH 设计工作台访问');
+    let bytes = 0;
+    const chunks: Buffer[] = [];
+    for await (const chunk of req) {
+      bytes += chunk.length;
+      if (bytes > designLimit * 2 + 16_384) throw new DesignError(413, '设计稿超过大小限制');
+      chunks.push(Buffer.from(chunk));
+    }
+    let input;
+    try { input = JSON.parse(Buffer.concat(chunks).toString('utf8')); } catch { return invalid('请求格式无效'); }
+    if (!input || typeof input !== 'object' || Array.isArray(input)) return invalid('请求格式无效');
+    const result = await studio.action(principal, input);
+    res.end(JSON.stringify(result));
+  } catch (err) {
+    res.statusCode = err instanceof DesignError ? err.status : 500;
+    res.end(JSON.stringify({ error: err instanceof DesignError ? err.message : '设计工作台暂时无法处理该请求' }));
+    if (!(err instanceof DesignError)) console.warn('[dsh-passwords] design studio:', err instanceof Error ? err.message : 'operation failed');
+  }
+}
