+@Composable
+internal fun DesignDeliveriesScreen(activeAccount: suspend () -> MobileAccountCredential?, onBack: () -> Unit) {
+    var account by remember { mutableStateOf<MobileAccountCredential?>(null) }
+    var projects by remember { mutableStateOf<List<DesignProject>?>(null) }
+    var error by remember { mutableStateOf<String?>(null) }
+    var retry by remember { mutableIntStateOf(0) }
+    var workspace by rememberSaveable { mutableStateOf<String?>(null) }
+    var delivery by rememberSaveable { mutableStateOf<String?>(null) }
+
+    LaunchedEffect(retry) {
+        error = null
+        try {
+            val current = activeAccount()
+            account = current
+            projects = current?.let {
+                MobileAccountClient.publishedDesigns(it).filter { project -> project.deliveries.isNotEmpty() }
+            }.orEmpty()
+        } catch (cancelled: CancellationException) {
+            throw cancelled
+        } catch (failure: Exception) {
+            error = failure.localizedMessage ?: "无法读取设计定稿"
+        }
+    }
+
+    val selectedWorkspace = workspace
+    val selectedDelivery = delivery
+    val currentAccount = account
+    if (currentAccount != null && selectedWorkspace != null && selectedDelivery != null) {
+        val close = { delivery = null; workspace = null }
+        BackHandler(onBack = close)
+        DesignPlaybackScreen(currentAccount, selectedWorkspace, selectedDelivery, close)
+        return
+    }
+
+    Column(Modifier.fillMaxSize().background(MaterialTheme.colorScheme.background).safeDrawingPadding()) {
+        Row(
+            Modifier.fillMaxWidth().padding(horizontal = 20.dp, vertical = 8.dp),
+            verticalAlignment = Alignment.CenterVertically
+        ) {
+            TopBarCircleButton(R.drawable.ic_back_chevron, "返回", onBack)
+            Spacer(Modifier.weight(1f))
+            Text("设计定稿", style = MaterialTheme.typography.titleLarge)
+            Spacer(Modifier.weight(1f))
+            Spacer(Modifier.size(46.dp))
+        }
+        val available = projects
+        when {
+            error != null -> DesignLoadStatus(error, onRetry = { retry++ })
+            available == null -> DesignLoadStatus()
+            currentAccount == null -> DesignLoadStatus("请先使用 DSH 服务器账号登录")
+            available.isEmpty() -> DesignLoadStatus("暂无设计定稿")
+            else -> LazyColumn {
+                available.forEach { project ->
+                    item(key = "project:${project.id}") {
+                        Text(project.title, Modifier.padding(start = 20.dp, top = 18.dp, bottom = 8.dp),
+                            style = MaterialTheme.typography.titleMedium, color = MaterialTheme.colorScheme.primary)
+                    }
+                    items(project.deliveries, key = { it.id }) { design ->
+                        ListItem(
+                            headlineContent = { Text(design.title) },
+                            supportingContent = { Text("第 ${design.revision} 版") },
+                            modifier = Modifier.clickable {
+                                workspace = project.id
+                                delivery = design.id
+                            }.testTag("design-delivery")
+                        )
+                    }
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun DesignPlaybackScreen(account: MobileAccountCredential, workspace: String, delivery: String, onBack: () -> Unit) {
+    var playback by remember(account, workspace, delivery) { mutableStateOf<DesignPlayback?>(null) }
+    var error by remember(account, workspace, delivery) { mutableStateOf<String?>(null) }
+    var playerOwnsControls by remember(account, workspace, delivery) { mutableStateOf(false) }
+    var retry by remember { mutableIntStateOf(0) }
+    LaunchedEffect(account, workspace, delivery, retry) {
+        error = null
+        playback = null
+        playerOwnsControls = false
+        try {
+            playback = MobileAccountClient.designPlayback(account, workspace, delivery)
+        } catch (cancelled: CancellationException) {
+            throw cancelled
+        } catch (failure: Exception) {
+            error = failure.localizedMessage ?: "无法打开定稿"
+        }
+    }
+    val request = playback
+    val immersive = playerOwnsControls && error == null && request != null
+    DesignSystemBars(immersive)
+    val insets = if (immersive) Modifier else Modifier.safeDrawingPadding()
+    Box(Modifier.fillMaxSize().background(Color(0xFF1F2023)).then(insets)) {
+        if (error == null && request != null) DesignWebView(
+            request, onClose = onBack, onReady = { playerOwnsControls = it }, onError = { error = it }
+        )
+        else DesignLoadStatus(error, onRetry = { retry++ }, color = Color.White)
+        if (!immersive) {
+            Box(Modifier.align(Alignment.TopStart).padding(10.dp)) {
+                TopBarCircleButton(R.drawable.ic_back_chevron, "返回定稿列表", onBack)
+            }
+        }
+    }
+}
+
+@Composable
+private fun DesignSystemBars(immersive: Boolean) {
+    val view = LocalView.current
+    DisposableEffect(view, immersive) {
+        val window = (view.context as? Activity)?.window
+        if (!immersive || window == null) return@DisposableEffect onDispose {}
+        val controller = WindowCompat.getInsetsController(window, view)
+        val insets = ViewCompat.getRootWindowInsets(view)
+        val statusBars = WindowInsetsCompat.Type.statusBars()
+        val navigationBars = WindowInsetsCompat.Type.navigationBars()
+        val previousBehavior = controller.systemBarsBehavior
+        controller.systemBarsBehavior = WindowInsetsControllerCompat.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE
+        controller.hide(statusBars or navigationBars)
+        onDispose {
+            controller.systemBarsBehavior = previousBehavior
+            if (insets?.isVisible(statusBars) != false) controller.show(statusBars)
+            if (insets?.isVisible(navigationBars) != false) controller.show(navigationBars)
+        }
+    }
+}
+
+@SuppressLint("SetJavaScriptEnabled")
+@Composable
+private fun DesignWebView(
+    playback: DesignPlayback,
+    onClose: () -> Unit,
+    onReady: (Boolean) -> Unit,
+    onError: (String) -> Unit
+) {
+    AndroidView(
+        modifier = Modifier.fillMaxSize(),
+        factory = { context ->
+            WebView(context).apply {
+                setBackgroundColor(0xFF1F2023.toInt())
+                settings.javaScriptEnabled = true
+                settings.allowFileAccess = false
+                settings.allowContentAccess = false
+                CookieManager.getInstance().setAcceptThirdPartyCookies(this, false)
+                webViewClient = object : WebViewClient() {
+                    override fun shouldOverrideUrlLoading(view: WebView, request: WebResourceRequest): Boolean {
+                        if (request.isForMainFrame && request.hasGesture() && view.url == playback.url &&
+                            request.url.scheme == "dsh-design-player" && request.url.host == "close"
+                        ) onClose()
+                        return true
+                    }
+                    override fun onPageFinished(view: WebView, url: String) {
+                        if (url == playback.url) {
+                            view.evaluateJavascript("Boolean(document.getElementById('exit-player'))") {
+                                onReady(it == "true")
+                            }
+                        }
+                    }
+                    override fun onReceivedHttpError(view: WebView, request: WebResourceRequest, response: WebResourceResponse) {
+                        if (request.isForMainFrame) onError("无法打开定稿（${response.statusCode}）")
+                    }
+                    override fun onReceivedError(view: WebView, request: WebResourceRequest, error: WebResourceError) {
+                        if (request.isForMainFrame) onError("预览连接失败，请重试")
+                    }
+                    override fun onRenderProcessGone(view: WebView, detail: RenderProcessGoneDetail): Boolean {
+                        onError("预览已中断，请重试")
+                        return true
+                    }
+                }
+                loadUrl(playback.url, mapOf("Authorization" to playback.authorization))
+            }
+        },
+        onRelease = { it.destroy() }
+    )
+}
+
+@Composable
+private fun DesignLoadStatus(
+    message: String? = null,
+    onRetry: (() -> Unit)? = null,
+    color: Color = MaterialTheme.colorScheme.onBackground
+) {
+    Box(Modifier.fillMaxSize().padding(24.dp), contentAlignment = Alignment.Center) {
+        if (message == null) CircularProgressIndicator()
+        else Column(horizontalAlignment = Alignment.CenterHorizontally, verticalArrangement = Arrangement.spacedBy(12.dp)) {
+            Text(message, color = color)
+            if (onRetry != null) Button(onClick = onRetry) { Text("重试") }
+        }
+    }
+}
