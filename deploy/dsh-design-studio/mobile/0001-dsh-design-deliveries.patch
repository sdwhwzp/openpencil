+import SwiftUI
+import WebKit
+
+struct DesignDeliveriesView: View {
+    let account: MobileAccountCredential?
+    @State private var projects: [DesignProject]?
+    @State private var error: String?
+    @State private var retry = 0
+    @State private var selection: DesignSelection?
+
+    var body: some View {
+        Group {
+            if account == nil {
+                ContentUnavailableView("请先使用 DSH 服务器账号登录", systemImage: "person.crop.circle")
+            } else if let error {
+                DesignLoadError(message: error) { retry += 1 }
+            } else if let projects {
+                if projects.isEmpty {
+                    ContentUnavailableView("暂无设计定稿", systemImage: "play.rectangle")
+                } else {
+                    List(projects) { project in
+                        Section(project.title) {
+                            ForEach(project.deliveries) { delivery in
+                                Button {
+                                    selection = DesignSelection(workspace: project.id, id: delivery.id)
+                                } label: {
+                                    VStack(alignment: .leading, spacing: 4) {
+                                        Text(delivery.title).foregroundStyle(.primary)
+                                        Text("第 \(delivery.revision) 版")
+                                            .font(.footnote)
+                                            .foregroundStyle(.secondary)
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+            } else {
+                ProgressView()
+            }
+        }
+        .navigationTitle("设计定稿")
+        .navigationBarTitleDisplayMode(.inline)
+        .task(id: retry) {
+            guard let account else { return }
+            error = nil
+            do {
+                projects = try await MobileAccountClient.publishedDesigns(account).filter { !$0.deliveries.isEmpty }
+            } catch {
+                if !Task.isCancelled { self.error = error.localizedDescription }
+            }
+        }
+        .fullScreenCover(item: $selection) { selection in
+            if let account { DesignPlaybackView(account: account, selection: selection) }
+        }
+    }
+}
+
+private struct DesignSelection: Identifiable {
+    let workspace: String
+    let id: String
+}
+
+private struct DesignPlaybackView: View {
+    let account: MobileAccountCredential
+    let selection: DesignSelection
+    @Environment(\.dismiss) private var dismiss
+    @State private var request: URLRequest?
+    @State private var error: String?
+    @State private var retry = 0
+    @State private var playerOwnsControls = false
+
+    private var immersive: Bool { playerOwnsControls && error == nil && request != nil }
+
+    var body: some View {
+        ZStack(alignment: .topLeading) {
+            Color(red: 0.12, green: 0.13, blue: 0.14).ignoresSafeArea()
+            if let error {
+                DesignLoadError(message: error) { retry += 1 }
+                    .frame(maxWidth: .infinity, maxHeight: .infinity)
+            } else if let request {
+                DesignWebView(request: request, onClose: { dismiss() }, onReady: {
+                    playerOwnsControls = $0
+                }, onError: { error = $0 })
+                    .ignoresSafeArea(.container, edges: immersive ? .all : [])
+            } else {
+                ProgressView().frame(maxWidth: .infinity, maxHeight: .infinity)
+            }
+            if !immersive {
+                Button {
+                    dismiss()
+                } label: {
+                    Image(systemName: "chevron.left")
+                        .font(.system(size: 17, weight: .semibold))
+                        .frame(width: 44, height: 44)
+                        .background(.regularMaterial, in: Circle())
+                }
+                .accessibilityLabel("返回定稿列表")
+                .padding(10)
+            }
+        }
+        .preferredColorScheme(.dark)
+        .statusBarHidden(immersive)
+        .persistentSystemOverlays(immersive ? .hidden : .automatic)
+        .task(id: retry) {
+            error = nil
+            request = nil
+            playerOwnsControls = false
+            do {
+                request = try await MobileAccountClient.designPlayback(account, workspace: selection.workspace, delivery: selection.id)
+            } catch {
+                if !Task.isCancelled { self.error = error.localizedDescription }
+            }
+        }
+    }
+}
+
+private struct DesignLoadError: View {
+    let message: String
+    let retry: () -> Void
+
+    var body: some View {
+        VStack(spacing: 12) {
+            Text(message).multilineTextAlignment(.center)
+            Button("重试", action: retry).buttonStyle(.bordered)
+        }
+        .padding(24)
+    }
+}
+
+private struct DesignWebView: UIViewRepresentable {
+    let request: URLRequest
+    let onClose: () -> Void
+    let onReady: (Bool) -> Void
+    let onError: (String) -> Void
+
+    func makeCoordinator() -> Coordinator {
+        Coordinator(url: request.url, onClose: onClose, onReady: onReady, onError: onError)
+    }
+
+    func makeUIView(context: Context) -> WKWebView {
+        let config = WKWebViewConfiguration()
+        config.websiteDataStore = .nonPersistent()
+        let view = WKWebView(frame: .zero, configuration: config)
+        view.navigationDelegate = context.coordinator
+        view.isOpaque = false
+        view.scrollView.bounces = false
+        view.scrollView.contentInsetAdjustmentBehavior = .never
+        view.load(request)
+        return view
+    }
+
+    func updateUIView(_ view: WKWebView, context: Context) {}
+
+    static func dismantleUIView(_ view: WKWebView, coordinator: Coordinator) {
+        view.navigationDelegate = nil
+        view.stopLoading()
+    }
+
+    final class Coordinator: NSObject, WKNavigationDelegate {
+        let url: URL?
+        let onClose: () -> Void
+        let onReady: (Bool) -> Void
+        let onError: (String) -> Void
+
+        init(url: URL?, onClose: @escaping () -> Void, onReady: @escaping (Bool) -> Void,
+             onError: @escaping (String) -> Void) {
+            self.url = url
+            self.onClose = onClose
+            self.onReady = onReady
+            self.onError = onError
+        }
+
+        func webView(_ view: WKWebView, decidePolicyFor action: WKNavigationAction,
+                     decisionHandler: @escaping (WKNavigationActionPolicy) -> Void) {
+            let target = action.request.url
+            if action.targetFrame?.isMainFrame == true, action.navigationType == .linkActivated,
+               target?.scheme == "dsh-design-player", target?.host == "close", view.url == url {
+                decisionHandler(.cancel)
+                onClose()
+                return
+            }
+            decisionHandler(action.targetFrame?.isMainFrame == true && action.request.url == url ? .allow : .cancel)
+        }
+
+        func webView(_ view: WKWebView, decidePolicyFor response: WKNavigationResponse,
+                     decisionHandler: @escaping (WKNavigationResponsePolicy) -> Void) {
+            guard let http = response.response as? HTTPURLResponse, http.url == url,
+                  response.isForMainFrame, (200..<300).contains(http.statusCode) else {
+                decisionHandler(.cancel)
+                onError("无法打开定稿，请重试")
+                return
+            }
+            decisionHandler(.allow)
+        }
+
+        func webView(_ view: WKWebView, didFinish navigation: WKNavigation!) {
+            guard view.url == url else { return }
+            view.evaluateJavaScript("Boolean(document.getElementById('exit-player'))") { value, _ in
+                self.onReady(value as? Bool == true)
+            }
+        }
+
+        func webView(_ view: WKWebView, didFailProvisionalNavigation navigation: WKNavigation!, withError error: Error) {
+            onError("预览连接失败，请重试")
+        }
+
+        func webView(_ view: WKWebView, didFail navigation: WKNavigation!, withError error: Error) {
+            onError("预览加载失败，请重试")
+        }
+
+        func webViewWebContentProcessDidTerminate(_ view: WKWebView) {
+            onError("预览已中断，请重试")
+        }
+    }
+}
