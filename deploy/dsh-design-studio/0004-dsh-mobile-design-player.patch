diff --git a/integrations/design-studio/player/board-player.mjs b/integrations/design-studio/player/board-player.mjs
new file mode 100644
index 0000000..0b78b1a
--- /dev/null
+++ b/integrations/design-studio/player/board-player.mjs
@@ -0,0 +1,106 @@
+import { boardDocument, boardsFor } from './boards.mjs';
+
+export function canvasSize(screen) {
+  const width = Math.max(1, screen.clientWidth);
+  const height = Math.max(1, screen.clientHeight);
+  const dpr = Math.max(1, Math.min(devicePixelRatio, 2, Math.sqrt(3_000_000 / (width * height))));
+  return { width, height, dpr };
+}
+
+export async function openBoards(screen, canvas, source, onScreen, onError) {
+  const boards = boardsFor(source);
+  if (!boards.length) throw new Error('此版本没有可播放的画板');
+  const runtime = new URL('./runtime/', location.href);
+  let size = canvasSize(screen);
+  function updateCanvas({ width, height, dpr }) {
+    canvas.width = Math.round(width * dpr);
+    canvas.height = Math.round(height * dpr);
+  }
+  updateCanvas(size);
+  const { createViewer } = await import(new URL('sdk.js', runtime));
+  const viewer = await createViewer({
+    canvas,
+    wasmUrl: new URL('op_web_sdk_bg.wasm', runtime).href,
+    canvasKitBaseUrl: new URL('canvaskit/', runtime).pathname,
+  });
+  if (viewer.wheelHandler) canvas.removeEventListener('wheel', viewer.wheelHandler);
+  screen.classList.add('board-scroll');
+
+  let index = 0;
+  let fit = false;
+  let scale = 1;
+  let bounds;
+  const overflow = screen.querySelector('#overflow');
+
+  function viewport() {
+    const { width, height } = size;
+    if (!bounds) {
+      viewer.zoomToFit(width, height);
+      return;
+    }
+    const left = (width - bounds.width * scale) / 2;
+    const top = Math.max(0, (height - bounds.height * scale) / 2) - screen.scrollTop;
+    const bottom = Math.max(0, height - top - bounds.height * scale);
+    canvas.style.clipPath = `inset(${Math.max(0, top)}px ${Math.max(0, left)}px ${bottom}px ${Math.max(0, left)}px)`;
+    viewer.setViewport({ panX: left - bounds.x * scale, panY: top - bounds.y * scale, zoom: scale });
+  }
+
+  function layout() {
+    scale = bounds ? Math.min(size.width / bounds.width, fit ? size.height / bounds.height : Infinity) : 1;
+    overflow.style.height = `${bounds ? Math.min(10_000_000, Math.max(0, Math.ceil(bounds.height * scale - size.height))) : 0}px`;
+    viewport();
+  }
+
+  function show(next) {
+    const board = boards[next];
+    if (!board) return;
+    index = next;
+    bounds = board.bounds;
+    viewer.load(boardDocument(source, board, bounds));
+    canvas.style.clipPath = '';
+    screen.scrollTop = 0;
+    layout();
+    onScreen(String(index), board.name);
+  }
+
+  screen.addEventListener('scroll', viewport, { passive: true });
+  let resizing = false;
+  let closed = false;
+  const observer = new ResizeObserver(async () => {
+    if (resizing || closed) return;
+    resizing = true;
+    try {
+      let nextSize = canvasSize(screen);
+      while (!closed && (size.width !== nextSize.width || size.height !== nextSize.height || size.dpr !== nextSize.dpr)) {
+        size = nextSize;
+        updateCanvas(size);
+        await viewer._inner.attach_canvas(canvas.id);
+        if (closed) return;
+        viewer._inner.push_scene();
+        layout();
+        nextSize = canvasSize(screen);
+      }
+    } catch {
+      onError('无法调整预览尺寸，请返回重新打开');
+    } finally {
+      resizing = false;
+      if (closed) viewer.destroy();
+    }
+  });
+  observer.observe(screen);
+  show(0);
+
+  return {
+    choices: boards.map((board, index) => ({ value: String(index), label: board.name })),
+    choose(value) { show(Number(value)); },
+    restart() { show(0); },
+    step(delta) { show(index + delta); },
+    fit(value) { fit = value; screen.scrollTop = 0; layout(); },
+    close() {
+      closed = true;
+      observer.disconnect();
+      screen.removeEventListener('scroll', viewport);
+      if (!resizing) viewer.destroy();
+    },
+  };
+}
diff --git a/integrations/design-studio/player/boards.mjs b/integrations/design-studio/player/boards.mjs
new file mode 100644
index 0000000..ba739af
--- /dev/null
+++ b/integrations/design-studio/player/boards.mjs
@@ -0,0 +1,82 @@
+const coordinate = value => Number.isFinite(value) ? value : 0;
+const visible = node => node && node.enabled !== false && node.visible !== false;
+
+export function rectangle(node, parent = { x: 0, y: 0 }) {
+  if (![node.width, node.height].every(value => Number.isFinite(value) && value > 0)) return null;
+  return {
+    x: parent.x + coordinate(node.x), y: parent.y + coordinate(node.y),
+    width: node.width, height: node.height,
+  };
+}
+
+export function contains(bounds, x, y) {
+  return x >= bounds.x && x < bounds.x + bounds.width && y >= bounds.y && y < bounds.y + bounds.height;
+}
+
+export function boardsFor(document) {
+  const pages = document.pages?.length ? document.pages : [{ id: 'default', name: document.name, children: document.children }];
+  return pages.flatMap(page => {
+    const nodes = (page.children ?? []).filter(visible);
+    const frames = nodes.filter(node => node.type === 'frame' && rectangle(node));
+    if (!frames.length) return nodes.length ? [{ page, nodes, name: page.name || '画布' }] : [];
+    return frames.map(frame => {
+      const bounds = rectangle(frame);
+      const roots = nodes.filter(node => node === frame || (
+        !frames.includes(node) && contains(bounds, coordinate(node.x), coordinate(node.y))
+      ));
+      const legacyBackdrop = !document.editorMeta && frames.length === 1 &&
+        frame.x === undefined && frame.y === undefined && !frame.children?.length && !frame.screen;
+      if (legacyBackdrop && roots[0] === frame && roots.length > 1) roots.push(roots.shift());
+      return { page, nodes: roots, frame, bounds, name: frame.name || page.name || '画板' };
+    });
+  });
+}
+
+export function hasPrototype(document) {
+  const containsScreen = nodes => (nodes ?? []).some(node => visible(node) && (
+    (node.type === 'frame' && typeof node.screen === 'string' && node.screen.startsWith('/'))
+    || containsScreen(node.children)
+  ));
+  if (document.pages?.length) {
+    const routedPages = new Set(Object.values(document.routes?.routes ?? {}).map(route => route?.pageId));
+    return document.pages.some(page => containsScreen(page.children) || (
+      routedPages.has(page.id) && (page.children ?? []).some(node => visible(node) && node.type === 'frame')
+    ));
+  }
+  return containsScreen(document.children);
+}
+
+export function boardDocument(document, board, bounds) {
+  const pageId = board.page.id || 'default';
+  const pages = document.pages?.length ? [...document.pages] : [board.page];
+  const activePageIndex = pages.indexOf(board.page);
+  const included = new Set(board.nodes);
+  const otherRoots = (board.page.children ?? []).filter(node => !included.has(node));
+  const children = [...board.nodes];
+  if (bounds) {
+    const used = new Set();
+    const scan = nodes => {
+      for (const node of nodes ?? []) {
+        used.add(node?.id);
+        scan(node?.children);
+      }
+    };
+    pages.forEach(page => scan(page.children));
+    let backdrop = 'dsh-player-backdrop';
+    while (used.has(backdrop)) backdrop += '-';
+    children.push({
+      type: 'rectangle', id: backdrop, ...bounds,
+      fill: [{ type: 'solid', color: board.page.backgroundColor || '#ffffff' }],
+    });
+  }
+  pages[activePageIndex] = { ...board.page, id: pageId, name: board.name, children };
+  if (otherRoots.length) {
+    let id = `${pageId}-components`;
+    while (pages.some(page => page.id === id)) id += '-';
+    pages.push({ id, name: board.name, children: otherRoots });
+  }
+  return JSON.stringify({
+    ...document, children, pages,
+    editorMeta: { ...document.editorMeta, activePageIndex },
+  });
+}
