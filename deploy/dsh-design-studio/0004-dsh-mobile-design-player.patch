+      hintUntil = hit ? 0 : now + 450;
+      schedule(true);
+    },
+    scroll(x, y, dx, dy) {
+      if (!player.scroll(x, y, dx, dy)) return false;
+      hintUntil = 0;
+      schedule(true);
+      return true;
+    },
+    close() {
+      observer.disconnect();
+      cancelAnimationFrame(raf);
+      clearTimeout(wake);
+      player.free();
+    },
+  };
+}
