diff --git a/integrations/design-studio/player/player.js b/integrations/design-studio/player/player.js
new file mode 100644
index 0000000..99fec18
--- /dev/null
+++ b/integrations/design-studio/player/player.js
@@ -0,0 +1,175 @@
+import { hasPrototype } from './boards.mjs';
+import { openBoards } from './board-player.mjs';
+import { openPrototype } from './prototype-player.mjs';
+
+const byId = id => document.getElementById(id);
+const screen = byId('screen');
+const canvas = byId('drawing');
+const status = byId('status');
+const menu = byId('options');
+const picker = byId('board');
+
+function errorMessage(message) {
+  byId('message').textContent = message;
+  status.hidden = false;
+}
+
+try {
+  const response = await fetch(`./document${location.search}`, { cache: 'no-store' });
+  if (!response.ok) throw new Error(response.status === 403 ? '当前账号没有此项目的访问权限' : '无法读取定稿，请返回重试');
+  const { design } = await response.json();
+  const source = JSON.parse(design.document);
+  const interactive = hasPrototype(source);
+  byId('title').textContent = design.title;
+  byId('revision').textContent = `第 ${design.revision} 版`;
+  document.title = `${design.title} · 定稿预览`;
+  let current;
+  const onScreen = (value, label) => {
+    current = value;
+    canvas.setAttribute('aria-label', label);
+    if (Array.from(picker.options).some(option => option.value === value)) picker.value = value;
+  };
+  const player = interactive
+    ? await openPrototype(screen, canvas, design.document, source, onScreen, errorMessage)
+    : await openBoards(screen, canvas, source, onScreen, errorMessage);
+
+  for (const choice of player.choices) picker.append(new Option(choice.label, choice.value));
+  if (Array.from(picker.options).some(option => option.value === current)) picker.value = current;
+  byId('picker-label').textContent = player.flowPicker ? '原型流程' : '画板';
+  byId('hints-option').hidden = !interactive;
+  byId('done').onclick = () => menu.close();
+  picker.onchange = () => {
+    player.choose(picker.value);
+    menu.close();
+  };
+  byId('restart').onclick = () => {
+    player.restart();
+    menu.close();
+  };
+  const fitButton = byId('fit');
+  function showFitMode(fit) {
+    fitButton.setAttribute('aria-pressed', String(fit));
+    fitButton.textContent = fit ? '适应宽度' : '完整画板';
+  }
+  fitButton.onclick = () => {
+    const fit = fitButton.getAttribute('aria-pressed') !== 'true';
+    showFitMode(fit);
+    player.fit(fit);
+    menu.close();
+  };
+  byId('hints').onchange = event => player.setHints?.(event.currentTarget.checked);
+  status.hidden = true;
+
+  const pointers = new Map();
+  let hold = 0;
+  let glide = 0;
+  let press;
+  let multiple;
+
+  function openMenu() {
+    cancelAnimationFrame(glide);
+    if (menu.open) return;
+    if (player.fitsEntireFrame) showFitMode(player.fitsEntireFrame());
+    menu.showModal();
+  }
+
+  canvas.oncontextmenu = event => {
+    event.preventDefault();
+    if (event.pointerType === 'mouse') openMenu();
+  };
+  canvas.onpointerdown = event => {
+    if (event.button !== 0) return;
+    cancelAnimationFrame(glide);
+    canvas.setPointerCapture(event.pointerId);
+    const point = { x: event.clientX, y: event.clientY };
+    pointers.set(event.pointerId, point);
+    clearTimeout(hold);
+    if (pointers.size === 1) {
+      multiple = false;
+      press = { id: event.pointerId, ...point, lastX: point.x, lastY: point.y, lastAt: performance.now(), vx: 0, vy: 0 };
+    } else {
+      multiple = true;
+    }
+    hold = setTimeout(openMenu, 470);
+  };
+  canvas.onpointermove = event => {
+    const origin = pointers.get(event.pointerId);
+    if (!origin) return;
+    const x = event.clientX;
+    const y = event.clientY;
+    if (Math.hypot(x - origin.x, y - origin.y) > 8) clearTimeout(hold);
+    if (!interactive || multiple || menu.open || press?.id !== event.pointerId) return;
+    if (!press.axis) {
+      const dx = Math.abs(x - press.x);
+      const dy = Math.abs(y - press.y);
+      if (dx <= 8 && dy <= 8) return;
+      press.axis = dx > dy ? 'horizontal' : 'vertical';
+    }
+    const now = performance.now();
+    const elapsed = Math.max(8, now - press.lastAt);
+    const dx = press.axis === 'horizontal' ? press.lastX - x : 0;
+    const dy = press.axis === 'vertical' ? press.lastY - y : 0;
+    player.scroll(press.x, press.y, dx, dy);
+    Object.assign(press, { lastX: x, lastY: y, lastAt: now, vx: dx / elapsed, vy: dy / elapsed });
+  };
+  function finish(event, cancelled) {
+    if (!pointers.delete(event.pointerId)) return;
+    clearTimeout(hold);
+    if (press?.id !== event.pointerId) return;
+    const start = press;
+    press = undefined;
+    if (cancelled || multiple || menu.open) return;
+    const dx = event.clientX - start.x;
+    const dy = event.clientY - start.y;
+    if (interactive) {
+      if (start.axis) {
+        if (performance.now() - start.lastAt < 85) animateGlide(start);
+      } else if (Math.hypot(dx, dy) <= 8) {
+        player.tap(event.clientX, event.clientY, performance.now());
+      }
+    } else if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.5) {
+      player.step(dx < 0 ? 1 : -1);
+    }
+  }
+  function animateGlide({ x, y, vx, vy }) {
+    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
+    let previous = performance.now();
+    function move(now) {
+      const elapsed = Math.min(32, Math.max(0, now - previous));
+      previous = now;
+      const decay = Math.exp(-elapsed / 120);
+      vx *= decay;
+      vy *= decay;
+      if (Math.hypot(vx, vy) > 0.07 && player.scroll(x, y, vx * elapsed, vy * elapsed)) {
+        glide = requestAnimationFrame(move);
+      }
+    }
+    glide = requestAnimationFrame(move);
+  }
+  canvas.onpointerup = event => finish(event, false);
+  canvas.onpointercancel = event => finish(event, true);
+  canvas.onlostpointercapture = event => finish(event, true);
+  if (interactive) {
+    canvas.addEventListener('wheel', event => {
+      const unit = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? screen.clientHeight : 1;
+      if (player.scroll(event.clientX, event.clientY, event.deltaX * unit, event.deltaY * unit)) event.preventDefault();
+    }, { passive: false });
+  }
+  document.addEventListener('keydown', event => {
+    if (menu.open || event.target.closest('button, select, input, a')) return;
+    if (event.key === 'Escape' || event.key === 'ContextMenu') {
+      event.preventDefault();
+      openMenu();
+    } else if (event.key === 'ArrowLeft') player.step?.(-1);
+    else if (event.key === 'ArrowRight') player.step?.(1);
+  });
+  window.addEventListener('pagehide', event => {
+    if (event.persisted) return;
+    clearTimeout(hold);
+    cancelAnimationFrame(glide);
+    player.close();
+  });
+} catch (error) {
+  console.error(error);
+  errorMessage(error instanceof Error ? error.message : '定稿预览加载失败，请返回重试');
+}
diff --git a/integrations/design-studio/player/prototype-player.mjs b/integrations/design-studio/player/prototype-player.mjs
