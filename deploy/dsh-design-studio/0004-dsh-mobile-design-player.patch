+  const observer = new ResizeObserver(() => {
+    const next = canvasSize(screen);
+    if (size.width === next.width && size.height === next.height && size.dpr === next.dpr) return;
+    size = next;
+    player.resize(size.width, size.height, size.dpr);
+    schedule(true);
+  });
+  observer.observe(screen);
+  schedule(true);
+
+  return {
+    choices: (flows.length ? flows : screens).map(screen => ({ value: screen.path, label: screen.flow || screen.name })),
+    flowPicker: flows.length > 0,
+    fitsEntireFrame: () => player.fits_entire_frame(),
+    choose(value) { start = value; restart(start); },
+    restart() { restart(start); },
+    fit(value) { player.fit_entire_frame(value); schedule(true); },
+    setHints(value) { hints = value; hintUntil = 0; schedule(true); },
+    tap(x, y, now) {
