index 0000000..a9999f3
--- /dev/null
+++ b/integrations/design-studio/player/prototype-player.mjs
@@ -0,0 +1,134 @@
+import { canvasSize } from './board-player.mjs';
+
+const bundledFonts = new Map([
+  ['Inter', 'Inter-VF.ttf'],
+  ['Roboto', 'Roboto-Regular.ttf'],
+  ['Noto Sans SC', 'NotoSansSC-VF.ttf'],
+  ['Noto Serif SC', 'NotoSerifSC-VF.ttf'],
+  ['Plus Jakarta Sans', 'PlusJakartaSans-VF.ttf'],
+  ['Archivo', 'Archivo-VF.ttf'],
+  ['Libre Caslon Text', 'LibreCaslonText-VF.ttf'],
+  ['Space Grotesk', 'SpaceGrotesk-VF.ttf'],
+  ['Manrope', 'Manrope-VF.ttf'],
+  ['Outfit', 'Outfit-VF.ttf'],
+  ['DM Sans', 'DMSans-VF.ttf'],
+  ['DM Serif Display', 'DMSerifDisplay-Regular.ttf'],
+  ['DM Mono', 'DMMono-Regular.ttf'],
+  ['Instrument Serif', 'InstrumentSerif-Regular.ttf'],
+  ['JetBrains Mono', 'JetBrainsMono-VF.ttf'],
+  ['Cormorant Garamond', 'CormorantGaramond-VF.ttf'],
+]);
+
+function fontsFor(source) {
+  const files = new Set();
+  function visit(nodes) {
+    for (const node of nodes ?? []) {
+      const file = bundledFonts.get(node.fontFamily);
+      if (file) files.add(file);
+      visit(node.children);
+    }
+  }
+  visit(source.children);
+  for (const page of source.pages ?? []) visit(page.children);
+  return files;
+}
+
+export async function openPrototype(screen, canvas, source, document, onScreen, onError) {
+  const engine = new URL('./engine/', location.href);
+  const { default: init, mount_prototype_player } = await import(new URL('op_host_web.js', engine));
+  await init();
+  const initial = canvasSize(screen);
+  canvas.width = Math.round(initial.width * initial.dpr);
+  canvas.height = Math.round(initial.height * initial.dpr);
+  const player = await mount_prototype_player(canvas.id, initial.width, initial.height, initial.dpr);
+  try {
+    await Promise.all(Array.from(fontsFor(document), async file => {
+      const response = await fetch(new URL(`assets/fonts/${file}`, engine), { signal: AbortSignal.timeout(8_000) });
+      if (response.ok) player.register_font(new Uint8Array(await response.arrayBuffer()));
+    }).map(load => load.catch(() => {})));
+    player.load(source, performance.now());
+  } catch (error) {
+    player.free();
+    throw error;
+  }
+
+  const screens = JSON.parse(player.screens());
+  const flows = screens.filter(screen => screen.flow);
+  let start;
+  let visibleScreen;
+  let hints = true;
+  let hintUntil = 0;
+  let flash = false;
+  let raf = 0;
+  let wake = 0;
+  let dirty = true;
+  let size = initial;
+
+  function schedule(force = false) {
+    dirty ||= force;
+    if (!raf) raf = requestAnimationFrame(draw);
+  }
+
+  function draw(now) {
+    raf = 0;
+    clearTimeout(wake);
+    const showHint = hints && now < hintUntil;
+    const due = player.frame(now, dirty || showHint !== flash, showHint);
+    dirty = false;
+    flash = showHint;
+    const active = screens[player.screen_index()];
