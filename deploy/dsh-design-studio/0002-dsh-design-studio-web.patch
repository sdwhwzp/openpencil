diff --git a/integrations/design-studio/editor/canvas.js b/integrations/design-studio/editor/canvas.js
new file mode 100644
index 0000000..c52763f
--- /dev/null
+++ b/integrations/design-studio/editor/canvas.js
@@ -0,0 +1,55 @@
+let version = 0;
+let buffer = { document: { version: '1.0.0', children: [], pages: [] } };
+let selection = {};
+function exchange(request) {
+  const ok = (body = {}) => ({ status: 200, body });
+  switch (request.path) {
+    case '/api/mcp/sync-reset':
+      return ok({ ok: true, version: ++version });
+    case '/api/mcp/version':
+      return ok({ version, collabSeq: 0 });
+    case '/api/mcp/document': {
+      if (request.method === 'GET') return ok({ ...buffer, version });
+      if (request.method !== 'POST') break;
+      const next = JSON.parse(request.body);
+      if (next.baseVersion !== undefined && next.baseVersion !== version)
+        return { status: 409, body: { ok: false, error: 'version-conflict', version } };
+      if (!next.document) break;
+      buffer = { document: next.document, activePageIndex: next.activePageIndex, preserveAuthoredGeometry: next.preserveAuthoredGeometry };
+      return ok({ ok: true, version: ++version });
+    }
+    case '/api/mcp/server': return ok({ serveMode: 'local' });
+    case '/api/mcp/indicators': return ok({ indicators: [] });
+    case '/api/mcp/selection':
+      if (request.method === 'POST') selection = JSON.parse(request.body);
+      return ok(selection);
+  }
+  return { status: 404, body: { error: 'unavailable' } };
+}
+
+try {
+  if (!navigator.serviceWorker) throw new Error('请通过 HTTPS 打开设计工作台');
+  navigator.serviceWorker.addEventListener('message', event => {
+    if (event.source !== navigator.serviceWorker.controller || event.data?.kind !== 'openpencil-buffer' || !event.ports[0]) return;
+    let response;
+    try { response = exchange(event.data); } catch { response = { status: 400, body: { error: 'invalid-document' } }; }
+    event.ports[0].postMessage(response);
+  });
+  await navigator.serviceWorker.register('./worker.js', { scope: './' });
+  await navigator.serviceWorker.ready;
+  if (!navigator.serviceWorker.controller) await new Promise(resolve => navigator.serviceWorker.addEventListener('controllerchange', resolve, { once: true }));
+  const canvas = document.querySelector('canvas');
+  const scale = Math.max(1, Math.min(devicePixelRatio, Math.sqrt(4000000 / Math.max(1, innerWidth * innerHeight))));
+  window.__opCanvasScale = scale;
+  canvas.width = Math.round(innerWidth * scale);
+  canvas.height = Math.round(innerHeight * scale);
+  canvas.style.width = `${innerWidth}px`;
+  canvas.style.height = `${innerHeight}px`;
+  const editor = await import('/gateway/design/runtime/op_host_web.js');
+  await editor.default();
+  await editor.mount_ck('op');
+} catch (err) {
+  const message = `画布加载失败。${err.message || err}`;
+  document.querySelector('#error').textContent = message;
+  parent.postMessage({ type: 'dsh-design/error', message }, location.origin);
+}
