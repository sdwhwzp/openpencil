diff --git a/integrations/design-studio/editor/worker.js b/integrations/design-studio/editor/worker.js
new file mode 100644
index 0000000..8136739
--- /dev/null
+++ b/integrations/design-studio/editor/worker.js
@@ -0,0 +1,36 @@
+const runtime = '/gateway/design/runtime/';
+self.addEventListener('install', event => event.waitUntil(self.skipWaiting()));
+self.addEventListener('activate', event => event.waitUntil(self.clients.claim()));
+self.addEventListener('fetch', event => {
+  const request = event.request;
+  const url = new URL(request.url);
+  if (url.origin !== self.location.origin) { event.respondWith(Response.error()); return; }
+  if (url.pathname.startsWith('/gateway/design/editor/') || url.pathname.startsWith(runtime)) return;
+  const match = /^\/(pkg|canvaskit|assets)\/(.+)$/.exec(url.pathname);
+  if (match && request.method === 'GET') {
+    const asset = match[1] === 'pkg' ? match[2] : `${match[1]}/${match[2]}`;
+    event.respondWith(fetch(runtime + asset, { credentials: 'same-origin' }));
+    return;
+  }
+  if (!url.pathname.startsWith('/api/mcp/')) {
+    event.respondWith(Response.json({ error: 'unavailable' }, { status: 404 }));
+    return;
+  }
+  event.respondWith((async () => {
+    const frame = await self.clients.get(event.clientId);
+    if (!frame || !frame.url.startsWith(self.registration.scope)) return new Response(null, { status: 403 });
+    if (url.pathname === '/api/mcp/events') return new Response(null, { status: 204 });
+    const channel = new MessageChannel();
+    const result = new Promise(resolve => {
+      const timer = setTimeout(() => { channel.port1.close(); resolve(new Response(null, { status: 504 })); }, 8000);
+      channel.port1.onmessage = ({ data }) => {
+        clearTimeout(timer);
+        channel.port1.close();
+        resolve(Response.json(data.body, { status: data.status }));
+      };
+    });
+    const body = request.method === 'POST' ? await request.text() : '';
+    frame.postMessage({ kind: 'openpencil-buffer', method: request.method, path: url.pathname, body }, [channel.port2]);
+    return result;
+  })());
+});
diff --git a/integrations/design-studio/figma-import-worker.js b/integrations/design-studio/figma-import-worker.js
new file mode 100644
index 0000000..7a01b1c
--- /dev/null
+++ b/integrations/design-studio/figma-import-worker.js
@@ -0,0 +1,22 @@
+import initialize, { FigmaTempWriter } from './runtime/op_host_web.js';
+
+self.onmessage = async ({ data: { file, maxDocumentBytes } }) => {
+  let writer;
+  try {
+    await initialize();
+    writer = new FigmaTempWriter(new Uint8Array(await file.arrayBuffer()), file.name);
+    if (!writer.page_count()) throw new Error('文件中没有可导入的设计页面');
+    const source = writer.full_document_json();
+    const warnings = JSON.parse(writer.warnings_json());
+    if (new Blob([source]).size > maxDocumentBytes) {
+      throw new Error(`转换后的设计超过 ${maxDocumentBytes / (1024 * 1024)} MiB，请在 Figma 中拆分后再导入`);
+    }
+    const design = JSON.parse(source);
+    design.editorMeta = { ...design.editorMeta, preserveAuthoredGeometry: true };
+    self.postMessage({ document: JSON.stringify(design), warnings });
+  } catch (error) {
+    self.postMessage({ error: error instanceof Error ? error.message : String(error) });
+  } finally {
+    writer?.free();
+  }
+};
