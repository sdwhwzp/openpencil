diff --git a/integrations/design-studio/preview.js b/integrations/design-studio/preview.js
new file mode 100644
index 0000000..2b363e8
--- /dev/null
+++ b/integrations/design-studio/preview.js
@@ -0,0 +1,39 @@
+const element = id => document.getElementById(id);
+const canvas = element('drawing');
+const params = new URLSearchParams(location.search);
+const root = '/gateway/design/runtime/viewer/';
+try {
+  const response = await fetch('/api/task-board/design', { method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json', 'x-dsh-design': '1' },
+    body: JSON.stringify({ action: 'preview', workspace: params.get('workspace'), delivery: params.get('delivery') }) });
+  const result = await response.json();
+  if (!response.ok || !result.design) throw new Error(result.error || '无法读取此版本');
+  const { title, revision, document: source } = result.design;
+  element('name').textContent = title; element('version').textContent = `第 ${revision} 版`;
+  document.title = `${title} · 设计预览`;
+  const doc = JSON.parse(source);
+  const pages = Array.isArray(doc.pages) && doc.pages.length ? doc.pages : [{ name: title, children: doc.children }];
+  const picker = element('page');
+  picker.replaceChildren(...pages.map((page, index) => new Option(page.name || `页面 ${index + 1}`, index)));
+  picker.hidden = pages.length < 2;
+  const pageSource = index => JSON.stringify({ ...doc, children: pages[index].children || [], pages: [pages[index]], editorMeta: { ...doc.editorMeta, activePageIndex: 0 } });
+  const sdk = await import('./runtime/viewer/sdk.js');
+  const resize = () => { canvas.width = Math.max(1, canvas.clientWidth); canvas.height = Math.max(1, canvas.clientHeight); };
+  resize();
+  const viewer = await sdk.createViewer({ canvas, doc: pageSource(0), wasmUrl: root + 'op_web_sdk_bg.wasm', canvasKitBaseUrl: root + 'canvaskit/' });
+  const fit = () => viewer.zoomToFit(canvas.clientWidth, canvas.clientHeight);
+  const zoom = factor => viewer.setZoom(Math.min(16, Math.max(0.02, viewer.viewport.zoom * factor)));
+  element('fit').onclick = fit; element('plus').onclick = () => zoom(1.3); element('minus').onclick = () => zoom(1 / 1.3);
+  picker.onchange = () => { viewer.load(pageSource(Number(picker.value))); fit(); };
+  const pointers = new Map();
+  const distance = () => { const [first, second] = pointers.values(); return second ? Math.hypot(first.x - second.x, first.y - second.y) : 0; };
+  canvas.onpointerdown = event => { canvas.setPointerCapture(event.pointerId); pointers.set(event.pointerId, { x: event.clientX, y: event.clientY }); };
+  canvas.onpointermove = event => {
+    const last = pointers.get(event.pointerId); if (!last) return;
+    const before = distance(); pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
+    if (before > 0) zoom(distance() / before);
+    else { const view = viewer.viewport; viewer.panTo(view.panX + event.clientX - last.x, view.panY + event.clientY - last.y); }
+  };
+  canvas.onpointerup = canvas.onpointercancel = event => pointers.delete(event.pointerId);
+  new ResizeObserver(() => { resize(); fit(); }).observe(element('view'));
+  fit(); element('message').hidden = true;
+} catch (err) { element('message').textContent = err.message || '设计预览加载失败'; }
