+import { createElement as h, useEffect, useRef } from 'react';
+import type { PropsLocale } from '@deepseek-ai/dsh-client-ui-slots';
+
+export function DesignLauncher({ wide, t, onOpen }: PropsLocale<'dshpw'> & { wide: boolean; onOpen(): void }) {
+  return h('button', { type: 'button', title: t('designStudio'), 'aria-label': t('designStudio'), onClick: onOpen,
+    className: `dshpw-sidebar-workspace-action${wide ? '' : ' compact'}` },
+    h('svg', { viewBox: '0 0 24 24', width: 18, height: 18, fill: 'none', stroke: 'currentColor', strokeWidth: 1.7, 'aria-hidden': true },
+      h('path', { d: 'M4 20l5-1 11-11-4-4L5 15l-1 5zm9-13 4 4' })), wide ? t('designStudio') : null);
+}
+
+export function DesignPanel({ t, openSession, projectId }: PropsLocale<'dshpw'> & { openSession(id: string): void; projectId?: string }) {
+  const frame = useRef<HTMLIFrameElement>(null);
+  useEffect(() => {
+    const receive = (event: MessageEvent) => {
+      if (event.source === frame.current?.contentWindow && event.origin === location.origin && event.data?.type === 'dsh-design/session' &&
+          typeof event.data.id === 'string') openSession(event.data.id);
+    };
+    window.addEventListener('message', receive);
+    return () => window.removeEventListener('message', receive);
+  }, [openSession]);
+  return h('iframe', { ref: frame, title: t('designStudio'), src: '/gateway/design/' + (projectId ? `?workspace=${encodeURIComponent(projectId)}` : ''),
+    style: { display: 'block', border: 0, width: '100%', height: '100%', flex: '1 1 auto', minHeight: 0 } });
+}
