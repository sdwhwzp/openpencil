diff --git a/integrations/design-studio/studio.js b/integrations/design-studio/studio.js
new file mode 100644
index 0000000..554e7ee
--- /dev/null
+++ b/integrations/design-studio/studio.js
@@ -0,0 +1,253 @@
+const control = Object.fromEntries(Array.from(document.querySelectorAll('[id]'), element => [element.id, element]));
+const api = async (action, values = {}) => {
+  const response = await fetch('/api/task-board/design', { method: 'POST', credentials: 'same-origin',
+    headers: { 'content-type': 'application/json', 'x-dsh-design': '1' }, body: JSON.stringify({ action, ...values }) });
+  const result = await response.json().catch(() => ({}));
+  if (!response.ok || (!result.projects && action === 'projects')) throw new Error(result.error || `工作台请求失败 (${response.status})`);
+  return result;
+};
+let workspace = '';
+let draft;
+let frame;
+let opened = false;
+let ready = false;
+let writable = false;
+let maxDocumentBytes;
+let switching = false;
+let working = false;
+let dirty = 0;
+let saved = 0;
+let timer;
+let timeout;
+let pending;
+let bridgeToken;
+let queue = Promise.resolve();
+const inDsh = parent !== window;
+control.home.hidden = inDsh;
+
+function say(message, error = false) {
+  control.status.textContent = message;
+  control.status.dataset.error = String(error);
+}
+function controls() {
+  const enabled = ready && writable && !switching && !working;
+  control.save.disabled = control.deliver.disabled = !enabled;
+  control.export.disabled = !ready || switching || working;
+  control.new.disabled = !writable || !workspace || switching || working;
+  control['import-figma'].disabled = control.new.disabled;
+  control['canvas-area'].inert = switching;
+  control.project.disabled = switching || working || !control.project.options.length;
+  control.draft.disabled = switching || working || !control.draft.options.length;
+  control.title.disabled = control.brief.disabled = !writable || !draft || switching;
+}
+function post(message) { frame?.contentWindow?.postMessage(JSON.stringify(message), location.origin); }
+function changed() {
+  dirty++;
+  say('有未保存的修改');
+  clearTimeout(timer);
+  timer = setTimeout(() => enqueue('save', true), 1400);
+}
+function snapshot() {
+  if (!ready) return Promise.reject(new Error('请等待画布打开'));
+  const id = crypto.randomUUID();
+  return new Promise((resolve, reject) => {
+    const deadline = setTimeout(() => { pending = undefined; reject(new Error('读取画布超时，请重试')); }, 20000);
+    pending = { id, resolve: value => { clearTimeout(deadline); pending = undefined; resolve(value); }, reject: err => { clearTimeout(deadline); pending = undefined; reject(err); } };
+    post({ type: 'op-bridge/snapshot', purpose: 'save', requestId: id });
+  });
+}
+const statuses = { backlog: '待处理', todo: '待执行', running: '开发中', done: '已完成', failed: '失败', cancelled: '已取消', started: '已交给 DSH', pending: '等待启动' };
+function history(items) {
+  control.history.hidden = !items?.length;
+  const list = control.history.querySelector('ul');
+  list.replaceChildren();
+  for (const item of items || []) {
+    const row = document.createElement('li');
+    const state = item.state === 'failed' ? 'failed' : item.status || item.state;
+    row.textContent = `第 ${item.revision} 版 · ${statuses[state] || state}`;
+    const url = new URL('./preview.html', location.href);
+    url.search = new URLSearchParams({ workspace, delivery: item.id }).toString();
+    const preview = document.createElement('a');
+    preview.href = url.href; preview.target = '_blank'; preview.rel = 'noopener'; preview.textContent = '手机预览';
+    const share = document.createElement('button');
+    share.textContent = '复制预览链接';
+    share.onclick = async () => {
+      try { await navigator.clipboard.writeText(url.href); say('预览链接已复制，可发到手机打开'); }
+      catch { const field = document.createElement('input'); field.readOnly = true; field.value = url.href; row.append(field); field.select(); }
+    };
+    row.append(document.createElement('br'), preview, share);
+    if (item.error || item.result) row.append(document.createElement('br'), document.createTextNode(item.error || item.result));
+    if (item.sessionId && inDsh) {
+      const button = document.createElement('button');
+      button.textContent = '打开开发会话';
+      button.onclick = async () => {
+        try { await leaveDraft(); parent.postMessage({ type: 'dsh-design/session', id: item.sessionId }, location.origin); }
+        catch (err) { say(err.message, true); }
+      };
+      row.append(button);
+    }
+    list.append(row);
+  }
+}
+function scoped() { return { workspace, id: draft.id }; }
+function enqueue(action, automatic = false) {
+  const current = draft;
+  const run = async () => {
+    if (!current || current !== draft || (automatic && (saved === dirty || !ready))) return;
+    const stamp = dirty;
+    working = true; controls();
+    try {
+      const shot = await snapshot();
+      if (action === 'export') {
+        const link = document.createElement('a');
+        link.href = URL.createObjectURL(new Blob([shot.docJson], { type: 'application/json' }));
+        link.download = `${control.title.value.trim() || 'design'}.op`; link.click();
+        setTimeout(() => URL.revokeObjectURL(link.href), 30000);
+        return;
+      }
+      const title = control.title.value.trim();
+      const brief = control.brief.value.trim();
+      const result = await api(action, { ...scoped(), revision: draft.revision, title, brief, document: shot.docJson });
+      draft = Object.assign(current, { title, brief, document: shot.docJson, revision: result.revision });
+      saved = stamp;
+      const option = Array.from(control.draft.options).find(item => item.value === draft.id);
+      if (option) option.textContent = title;
+      post({ type: 'op-bridge/save-committed', generation: shot.generation, revision: shot.revision });
+      if (result.deliveries) history(result.deliveries);
+      const failed = result.deliveries?.[0]?.state === 'failed';
+      say(failed ? `草稿已保存，启动失败：${result.deliveries[0].error}` : action === 'deliver' ? `第 ${result.revision} 版已交给 DSH` : `草稿已保存 · 第 ${result.revision} 版`, failed);
+    } catch (err) { say(err.message, true); throw err; }
+    finally { working = false; controls(); }
+  };
+  const next = queue.then(run);
+  queue = next.catch(() => {});
+  return automatic ? queue : next;
+}
+async function leaveDraft() {
+  clearTimeout(timer);
+  await queue;
+  if (ready && saved !== dirty) await enqueue('save');
+}
+function clearCanvas() {
+  clearTimeout(timer); clearTimeout(timeout);
+  pending?.reject(new Error('画布已切换'));
+  frame?.remove(); frame = undefined; draft = undefined;
+  dirty = saved = 0; opened = ready = false;
+  control.title.value = control.brief.value = '';
+  control.empty.hidden = false; history([]); controls();
+}
+function mount(result) {
+  clearCanvas();
+  draft = result.draft;
+  control.title.value = draft.title; control.brief.value = draft.brief;
+  control.draft.value = draft.id;
+  history(result.deliveries);
+  control.empty.textContent = '正在打开 OpenPencil 画布…';
+  bridgeToken = crypto.randomUUID();
+  frame = document.createElement('iframe');
+  frame.title = 'OpenPencil 编辑器';
+  frame.src = `./editor/?embed=vscode&locale=zh-CN&theme=${matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'}`;
+  control['canvas-area'].append(frame);
+  timeout = setTimeout(() => { if (!ready) say('画布未就绪，请检查浏览器的 WebGL 和 HTTPS 连接，再刷新页面', true); }, 75000);
+  say(`已载入第 ${draft.revision} 版`); controls();
+}
+window.addEventListener('message', event => {
+  if (!frame || event.source !== frame.contentWindow || event.origin !== location.origin) return;
+  let msg = event.data;
+  if (typeof msg === 'string') { try { msg = JSON.parse(msg); } catch { return; } }
+  switch (msg?.type) {
+    case 'dsh-design/error': clearTimeout(timeout); control.empty.hidden = true; say(msg.message, true); break;
+    case 'op-bridge/listening': post({ type: 'op-bridge/init', token: bridgeToken }); break;
+    case 'op-bridge/ready':
+      if (!opened) { opened = true; post({ type: 'op-bridge/open-document', json: draft.document }); }
+      break;
+    case 'op-bridge/opened': ready = true; clearTimeout(timeout); control.empty.hidden = true; controls(); break;
+    case 'op-bridge/dirty-changed': if (msg.dirty && ready && writable) changed(); break;
+    case 'op-bridge/snapshot-result': if (pending?.id === msg.requestId) pending.resolve(msg); break;
+    case 'op-bridge/snapshot-conflict': pending?.reject(new Error('画布版本冲突，请重新打开设计稿')); break;
+    case 'op-shell/save': if (writable && ready) enqueue('save').catch(() => {}); break;
+  }
+});
+async function choose(project, id, create = false) {
+  switching = true; controls();
+  try {
+    await leaveDraft();
+    const result = await api('list', { workspace: project });
+    if (create) id = crypto.randomUUID();
+    else id ||= result.drafts[0]?.id;
+    let openedDraft;
+    if (id) openedDraft = await api(create ? 'new' : 'open', { workspace: project, id });
+    workspace = project; control.project.value = project;
+    control.draft.replaceChildren(...result.drafts.map(item => new Option(item.title, item.id)));
+    if (create) control.draft.add(new Option(openedDraft.draft.title, id), 0);
+    if (openedDraft) mount(openedDraft);
+    else { clearCanvas(); control.empty.textContent = '这个项目还没有设计稿，点击「新建」开始绘制。'; say(''); }
+  } catch (err) { control.project.value = workspace; control.draft.value = draft?.id || ''; say(err.message, true); }
+  finally { switching = false; controls(); }
+}
+async function convertFigma(file) {
+  const worker = new Worker(new URL('./figma-import-worker.js', import.meta.url), { type: 'module' });
+  let deadline;
+  try {
+    return await new Promise((resolve, reject) => {
+      deadline = setTimeout(() => reject(new Error('转换超时，请拆分文件后重试')), 600_000);
+      worker.onmessage = ({ data }) => data.error ? reject(new Error(data.error)) : resolve(data);
+      worker.onerror = worker.onmessageerror = () => reject(new Error('无法加载 Figma 转换器，请刷新后重试'));
+      worker.postMessage({ file, maxDocumentBytes });
+    });
+  } finally {
+    clearTimeout(deadline);
+    worker.terminate();
+  }
+}
+
+control.new.onclick = () => choose(workspace, null, true);
+control['import-figma'].onclick = () => control['figma-file'].click();
+control['figma-file'].onchange = async event => {
+  const input = event.currentTarget;
+  const file = input.files[0];
+  input.value = '';
+  if (!file || control['import-figma'].disabled) return;
+  if (!/\.fig$/i.test(file.name)) { say('请选择 Figma Design 的 .fig 文件', true); return; }
+  switching = true;
+  controls();
+  try {
+    await leaveDraft();
+    say(`正在导入 ${file.name}…`);
+    const converted = await convertFigma(file);
+    const id = crypto.randomUUID();
+    const title = file.name.slice(0, -4).trim().slice(0, 100) || 'Figma 设计';
+    const result = await api('import', { workspace, id, title, document: converted.document });
+    control.draft.add(new Option(result.draft.title, id), 0);
+    mount(result);
+    const warnings = converted.warnings;
+    say(warnings.length ? `已导入为新草稿。${warnings.length} 条转换提示，首条为 ${warnings[0]}` : '已导入为新草稿');
+  } catch (error) {
+    say(`导入失败。${error.message}`, true);
+  } finally {
+    switching = false;
+    controls();
+  }
+};
+control.project.onchange = () => choose(control.project.value);
+control.draft.onchange = () => choose(workspace, control.draft.value);
+control.save.onclick = () => enqueue('save').catch(() => {});
+control.export.onclick = () => enqueue('export').catch(() => {});
+control.deliver.onclick = () => enqueue('deliver').catch(() => {});
+control.title.oninput = control.brief.oninput = changed;
+window.addEventListener('beforeunload', event => { if (saved !== dirty) { event.preventDefault(); event.returnValue = ''; } });
+setInterval(async () => {
+  if (document.hidden || !draft || control.history.hidden || working || switching) return;
+  const current = draft;
+  try { const result = await api('history', scoped()); if (current === draft) history(result.deliveries); } catch (err) { say(err.message, true); }
+}, 8000);
+try {
+  controls();
+  const result = await api('projects');
+  writable = result.writable;
+  maxDocumentBytes = result.maxDocumentBytes;
+  control.project.replaceChildren(...result.projects.map(project => new Option(project.title, project.id)));
+  const initial = new URLSearchParams(location.search).get('workspace');
+  if (result.projects.length) await choose(result.projects.find(project => project.id === initial)?.id || result.projects[0].id);
+  else control.empty.textContent = '当前账号还没有可访问的服务器项目。';
+} catch (err) { control.empty.textContent = err.message; say(err.message, true); }
