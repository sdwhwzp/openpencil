+  if (!/^[a-f0-9-]{36}$/.test(id ?? '')) throw new Error('画布会话无效');
+  const identity = await fetch(`/api/task-board/design-editor/${id}/identity`);
+  if (!identity.ok) throw new Error('画布会话已结束，请重新打开草稿');
+  const { account } = await identity.json();
+  if (!/^[a-f0-9]{32}$/.test(account ?? '')) throw new Error('画布账号无效');
+  url.search = new URLSearchParams({ editor: id, account });
+  history.replaceState(null, '', url);
+  const canvas = document.querySelector('canvas');
+  const scale = Math.max(1, Math.min(devicePixelRatio, Math.sqrt(4000000 / Math.max(1, innerWidth * innerHeight))));
