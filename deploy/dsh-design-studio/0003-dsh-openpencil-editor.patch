@@ -0,0 +1,310 @@
+import { spawn } from 'node:child_process';
+import { createHash, randomBytes, randomUUID } from 'node:crypto';
+import { once } from 'node:events';
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs';
+import { createServer, request, type IncomingMessage, type ServerResponse } from 'node:http';
+import path from 'node:path';
+import { createInterface } from 'node:readline';
+import { pipeline } from 'node:stream/promises';
+import { fileURLToPath } from 'node:url';
+import { DesignModelInputError, streamDesignModel, studioModels, type DesignModelRoute, type DesignModelSource } from './design-editor-model.js';
+import type { AuthenticatedPrincipal } from './principal.js';
+
+export const editorPrefix = '/api/task-board/design-editor';
+export const editorBodyLimit = 48 * 1024 * 1024;
+const idleTime = 15 * 60_000;
+const bundle = fileURLToPath(new URL('./design-runtime/', import.meta.url));
+
+const reads = new Set([
+  '/api/mcp/server', '/api/mcp/version', '/api/mcp/document', '/api/mcp/events', '/api/mcp/indicators',
+  '/api/mcp/selection', '/api/ai/models', '/api/ai/hosted/models', '/api/collab/state',
+  '/api/settings/credential-policy', '/assets/iconify-catalog-brands.json',
+]);
+const writes = new Set([
+  '/api/mcp/sync-reset', '/api/mcp/document', '/api/mcp/selection',
+  '/api/ai/standard', '/api/ai/stream', '/api/ai/models/discover', '/api/ai/image/search', '/api/ai/image/generate',
+  '/api/ai/site-import', '/api/figma/convert', '/api/export/pdf', '/api/export/raster', '/api/generator/run',
+  '/api/collab/action', '/api/collab/presence', '/api/collab/avatar',
+]);
+
+interface Editor {
+  owner: string;
+  workspace: string;
+  draft: string;
+  token: string;
+  account: string;
+  port: number;
+  stop: () => void;
+  signal: AbortSignal;
+  authorize: () => Promise<boolean>;
+  models?: DesignModelSource;
+  routes: Map<string, DesignModelRoute>;
+  modelRequests: number;
+  usedAt: number;
+  busy: number;
+}
+
+export class DesignEditorError extends Error {
+  constructor(readonly status: number, message: string) { super(message); }
+}
+
+function sameOrigin(req: IncomingMessage): boolean {
+  const site = req.headers['sec-fetch-site'];
+  if (site) return site === 'same-origin';
+  const origin = req.headers.origin;
+  return !origin || origin === `http://${req.headers.host}` || origin === `https://${req.headers.host}`;
+}
+
+export class DesignEditorRuntime {
+  private readonly editors = new Map<string, Editor>();
+  private readonly modelServer = createServer({ requestTimeout: 60_000 }, (req, res) => void this.modelRequest(req, res));
+  private modelOrigin?: Promise<string>;
+  private readonly reap = setInterval(() => {
+    const deadline = Date.now() - idleTime;
+    for (const editor of this.editors.values()) {
+      if (!editor.busy && editor.usedAt < deadline) editor.stop();
+    }
+  }, 60_000).unref();
+
+  constructor(private readonly dataRoot: string, private readonly modelsFor?: (principal: AuthenticatedPrincipal) => DesignModelSource) {}
+
+  private listenForModels(): Promise<string> {
+    if (!this.modelOrigin) {
+      this.modelServer.listen(0, '127.0.0.1');
+      this.modelOrigin = once(this.modelServer, 'listening').then(() => {
+        this.modelServer.unref();
+        const address = this.modelServer.address();
+        if (!address || typeof address === 'string') throw new Error('Invalid design model listener');
+        return `http://127.0.0.1:${address.port}`;
+      });
+    }
+    return this.modelOrigin;
+  }
+
+  private async modelRequest(req: IncomingMessage, res: ServerResponse): Promise<void> {
+    const match = /^\/([a-f0-9-]{36})\/(dsh-[a-f0-9]{24})\/chat\/completions$/.exec(req.url ?? '');
+    const editor = match && this.editors.get(match[1]);
+    const route = editor && editor.routes.get(match[2]);
+    if (!editor || !editor.models || !route || req.method !== 'POST' ||
+        req.headers.authorization !== `Bearer ${editor.token}`) {
+      res.writeHead(403).end();
+      req.resume();
+      return;
+    }
+    if (editor.modelRequests >= 8) {
+      res.writeHead(429).end();
+      req.resume();
+      return;
+    }
+    const disconnected = new AbortController();
+    res.once('close', () => disconnected.abort());
+    const signal = AbortSignal.any([editor.signal, disconnected.signal, AbortSignal.timeout(300_000)]);
+    editor.modelRequests++;
+    try {
+      if (!await editor.authorize()) throw new DesignEditorError(403, '此账号没有项目写入权限');
+      signal.throwIfAborted();
+      await streamDesignModel(await readBody(req), route, editor.models, res, signal);
+    } catch (error) {
+      if (res.destroyed) return;
+      if (!res.headersSent) {
+        const status = error instanceof DesignEditorError ? error.status : error instanceof DesignModelInputError ? 400 : 502;
+        res.writeHead(status).end();
+        req.resume();
+      } else res.end('data: {"error":{"message":"模型请求中断"}}\n\n');
+    } finally { editor.modelRequests--; }
+  }
+
+  async open(principal: AuthenticatedPrincipal, workspace: string, draft: string, authorize: () => Promise<boolean>): Promise<{ id: string }> {
+    const binary = process.env.DSH_OPENPENCIL_EDITOR_BIN;
+    if (!binary || !path.isAbsolute(binary)) throw new DesignEditorError(503, 'OpenPencil 服务尚未配置');
+    if (this.editors.size >= 24 || [...this.editors.values()].filter(item => item.owner === principal.id).length >= 4) {
+      throw new DesignEditorError(429, '打开的设计画布过多，请关闭不用的页面后重试');
+    }
+    const root = path.join(this.dataRoot, '.dsh-design-studio', 'editors');
+    mkdirSync(root, { recursive: true, mode: 0o700 });
+    const directory = mkdtempSync(path.join(root, 'editor-'));
+    const id = randomUUID();
+    const token = randomBytes(32).toString('hex');
+    const lease = new AbortController();
+    const account = createHash('sha256').update(`${principal.source}:${principal.id}`).digest('hex').slice(0, 32);
+    const editor: Editor = {
+      owner: principal.id, workspace, draft, token, account, port: 0, usedAt: Date.now(), busy: 0,
+      authorize, signal: lease.signal, routes: new Map(), modelRequests: 0,
+      stop: () => {
+        this.editors.delete(id);
+        lease.abort();
+      },
+    };
+    this.editors.set(id, editor);
+    const config = path.join(directory, 'config');
+    try {
+      if (this.modelsFor) {
+        const source = this.modelsFor(principal);
+        const signal = AbortSignal.any([lease.signal, AbortSignal.timeout(15_000)]);
+        const catalog = await source.catalog(signal).catch(() => undefined);
+        lease.signal.throwIfAborted();
+        if (catalog?.groups.length) {
+          const { configs, routes } = studioModels(catalog, await this.listenForModels(), id, token);
+          mkdirSync(config, { mode: 0o700 });
+          writeFileSync(path.join(config, 'settings.json'), JSON.stringify({ version: 1, builtin_agents: configs }), { mode: 0o600 });
+          editor.models = source;
+          editor.routes = routes;
+        }
+      }
+    } catch {
+      editor.stop();
+      rmSync(directory, { recursive: true, force: true });
+      throw new DesignEditorError(503, '无法载入 DSH 内置模型配置，请重新打开草稿');
+    }
+    const child = spawn(binary, ['--serve-web', '--managed', '--host', '127.0.0.1', '--port', '0', '--config-root', config], {
+      cwd: directory,
+      env: {
+        PATH: process.env.PATH,
+        LANG: process.env.LANG ?? 'C.UTF-8',
+        HOME: directory,
+        TMPDIR: directory,
+        OPENPENCIL_WEB_BUNDLE_DIR: bundle,
+        OPENPENCIL_DSH_STUDIO_TOKEN: token,
+      },
+      stdio: ['pipe', 'pipe', 'ignore'],
+    });
+    const release = editor.stop;
+    editor.stop = () => {
+      if (lease.signal.aborted) return;
+      release();
+      child.stdin.end();
+      const deadline = setTimeout(() => child.kill('SIGKILL'), 3000).unref();
+      child.once('close', () => clearTimeout(deadline));
+    };
+    child.stdin.on('error', () => {});
+    child.once('close', () => {
+      release();
+      try { rmSync(directory, { recursive: true, force: true }); } catch { console.warn('[dsh-passwords] OpenPencil editor cleanup failed'); }
+    });
+    const lines = createInterface({ input: child.stdout });
+    try {
+      const signal = AbortSignal.any([lease.signal, AbortSignal.timeout(15_000)]);
+      const [line] = await Promise.race([
+        once(lines, 'line', { signal }),
+        once(child, 'close', { signal }).then(() => { throw new Error('OpenPencil exited'); }),
+      ]);
+      const ready = JSON.parse(String(line));
+      if (!ready.ok || ready.version !== '0.8.5' || !Number.isInteger(ready.port) || ready.port < 1 || ready.port > 65535) throw new Error('invalid OpenPencil startup response');
+      editor.port = ready.port;
+      const check = await fetch(`http://127.0.0.1:${editor.port}/api/mcp/server`, { signal, redirect: 'error' });
+      await check.body?.cancel();
+      if (check.status !== 403) throw new Error('OpenPencil daemon requires DSH Studio token support');
+      return { id };
+    } catch {
+      editor.stop();
+      throw new DesignEditorError(503, 'OpenPencil 服务启动失败，请检查服务器上的运行包');
+    } finally {
+      lines.close();
+      child.stdout.resume();
+    }
+  }
+
+  close(): void {
+    clearInterval(this.reap);
+    for (const editor of this.editors.values()) editor.stop();
+    this.modelServer.close();
+  }
+
+  release(principal: AuthenticatedPrincipal, workspace: string, draft: string, key: unknown): void {
+    const editor = typeof key === 'string' ? this.editors.get(key) : undefined;
+    if (editor?.owner === principal.id && editor.workspace === workspace && editor.draft === draft) editor.stop();
+  }
+
+  async proxy(
+    req: IncomingMessage, res: ServerResponse, principal: AuthenticatedPrincipal,
+  ): Promise<void> {
+    try {
+      const url = new URL(req.url ?? '/', 'http://localhost');
+      const route = url.pathname.slice(editorPrefix.length + 1);
+      const sep = route.indexOf('/');
+      const editor = sep < 0 ? undefined : this.editors.get(route.slice(0, sep));
+      if (!editor || !editor.port || editor.owner !== principal.id) throw new DesignEditorError(404, '设计画布会话已结束，请重新打开草稿');
+      const target = route.slice(sep);
+      const reading = req.method === 'GET' && (target === '/identity' || reads.has(target) || /^\/pkg\/assets\/[A-Za-z0-9_./-]+$/.test(target));
+      const writing = req.method === 'POST' && writes.has(target);
+      if (!reading && !writing) throw new DesignEditorError(404, 'OpenPencil 路由不存在');
+      if (writing && (!sameOrigin(req) || !req.headers['content-type']?.startsWith('application/json'))) throw new DesignEditorError(403, '需要从 DSH 设计工作台访问');
+      if (!await editor.authorize()) {
+        editor.stop();
+        throw new DesignEditorError(403, '此账号没有项目写入权限');
+      }
+      if ((req.destroyed && !req.complete) || res.destroyed) return;
+      if (editor.signal.aborted) throw new DesignEditorError(404, '设计画布会话已结束，请重新打开草稿');
+      if (target === '/identity') {
+        res.writeHead(200, { 'content-type': 'application/json; charset=utf-8', 'cache-control': 'no-store' });
+        res.end(JSON.stringify({ account: editor.account }));
+        return;
+      }
+      const body = writing ? await readBody(req) : undefined;
+      editor.usedAt = Date.now();
+      const longRequest = writing && (target.startsWith('/api/ai/') || target === '/api/generator/run');
+      if (longRequest && editor.busy >= 8) throw new DesignEditorError(429, '同时运行的 AI 请求过多');
+      if (longRequest) editor.busy++;
+      try { await forward(res, editor, target, body); }
+      finally {
+        if (longRequest) editor.busy--;
+        editor.usedAt = Date.now();
+      }
+    } catch (error) {
+      if (res.destroyed) return;
+      if (res.headersSent) { res.destroy(); return; }
+      const expected = error instanceof DesignEditorError;
+      res.writeHead(expected ? error.status : 502, { 'content-type': 'application/json; charset=utf-8', 'cache-control': 'no-store' });
+      res.end(JSON.stringify({ error: expected ? error.message : 'OpenPencil 服务连接中断，请重新打开草稿' }));
+    }
+  }
+}
+
+async function readBody(req: IncomingMessage): Promise<Buffer> {
+  if (Number(req.headers['content-length'] ?? 0) > editorBodyLimit) {
+    req.resume();
+    throw new DesignEditorError(413, '画布请求超过大小限制');
+  }
+  let bytes = 0;
+  const chunks: Buffer[] = [];
+  for await (const chunk of req.iterator({ destroyOnReturn: false })) {
+    bytes += chunk.length;
+    if (bytes > editorBodyLimit) {
+      req.resume();
+      throw new DesignEditorError(413, '画布请求超过大小限制');
+    }
+    chunks.push(Buffer.from(chunk));
+  }
+  return Buffer.concat(chunks);
+}
+
+async function forward(res: ServerResponse, editor: Editor, target: string, body?: Buffer): Promise<void> {
+  const upstream = request({
+    host: '127.0.0.1', port: editor.port, path: target, method: body ? 'POST' : 'GET',
+    headers: {
+      authorization: `Bearer ${editor.token}`,
+      ...(body ? { 'content-type': 'application/json', 'content-length': body.length } : {}),
+    },
+  });
+  upstream.setTimeout(600_000, () => upstream.destroy(new Error('OpenPencil request timed out')));
+  const disconnected = () => upstream.destroy();
+  res.once('close', disconnected);
+  try {
+    const answer = new Promise<IncomingMessage>((resolve, reject) => {
+      upstream.once('response', resolve);
+      upstream.once('error', reject);
+    });
+    upstream.end(body);
+    const response = await answer;
+    for (const header of ['content-type', 'content-length', 'content-disposition']) {
+      const value = response.headers[header];
+      if (value) res.setHeader(header, value);
+    }
+    res.setHeader('cache-control', 'no-store');
+    res.setHeader('x-content-type-options', 'nosniff');
+    res.setHeader('x-accel-buffering', 'no');
+    res.statusCode = response.statusCode ?? 502;
+    res.flushHeaders();
+    await pipeline(response, res);
+  } finally { res.off('close', disconnected); }
+}
