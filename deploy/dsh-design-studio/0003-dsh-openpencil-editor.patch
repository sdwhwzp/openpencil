new file mode 100644
index 0000000000000000000000000000000000000000..3edcadf36a5632c2ad6a069c452ee90d10704a71
--- /dev/null
+++ b/src/design-git.ts
@@ -0,0 +1,43 @@
+import { execFile } from 'node:child_process';
+import { realpath, stat } from 'node:fs/promises';
+import { promisify } from 'node:util';
+import { managedGitEnv, managedGitRemoteArgs } from './managed-git.js';
+
+const git = promisify(execFile);
+
+export interface DesignGitTarget {
+  repository: string;
+  branch: string;
+}
+
+function repositoryIdentity(remote: string): string | undefined {
+  if (!remote || /[\p{Cc}\s]/u.test(remote)) return;
+  if (!remote.includes('://')) {
+    const ssh = /^(?:[^@/:]+@)?(\[[a-f0-9:]+\]|[\w.-]+):([^?#]+)$/i.exec(remote);
+    if (ssh) return `ssh://${ssh[1].toLowerCase()}/${ssh[2].replace(/^\/+/, '')}`;
+    return;
+  }
+  try {
+    const url = new URL(remote);
+    if (!['https:', 'http:', 'ssh:', 'git:'].includes(url.protocol) || !url.hostname || url.pathname === '/') return;
+    url.username = url.password = url.search = url.hash = '';
+    return url.href;
+  } catch { return; }
+}
+
+export async function designGitTarget(directory: string, dataRoot: string): Promise<DesignGitTarget | undefined> {
+  try {
+    if (await realpath(directory) !== directory || (await stat(directory)).dev !== (await stat(dataRoot)).dev) return;
+    const run = async (...args: string[]) => (await git('git', ['-C', directory, ...args], {
+      timeout: 5000, maxBuffer: 64 * 1024, windowsHide: true, env: managedGitEnv(process.env, directory),
+    })).stdout.trim();
+    const [root, branch] = (await run('rev-parse', '--show-toplevel', '--abbrev-ref', 'HEAD')).split('\n');
+    if (root !== directory || !branch || branch === 'HEAD') return;
+    const repository = repositoryIdentity(await run(...managedGitRemoteArgs()));
+    return repository ? { repository, branch } : undefined;
+  } catch { return; }
+}
+
+export function sameDesignGit(left?: DesignGitTarget | null, right?: DesignGitTarget | null): boolean {
+  return !!left && !!right && left.repository === right.repository && left.branch === right.branch;
+}
