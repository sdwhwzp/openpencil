@@ -0,0 +1,32 @@
+window.addEventListener('keydown', event => {
+  if (event.key.toLowerCase() !== 's' || !(event.metaKey || event.ctrlKey) || event.shiftKey || event.altKey) return;
+  event.preventDefault();
