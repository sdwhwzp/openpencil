new file mode 100644
index 0000000000000000000000000000000000000000..42826785bca2f8180de4ce2b0e8ec5af25d45266
--- /dev/null
+++ b/src/design-editor-model.ts
@@ -0,0 +1,129 @@
+import { createHash } from 'node:crypto';
+import { once } from 'node:events';
+import type { ServerResponse } from 'node:http';
+import type { AttachmentStore, ImageMediaType } from '@deepseek-ai/dsh-attachment';
+import { createAssistantMessage, ReasoningEffortId, type GenerateOptions, type LlmRuntime } from '@deepseek-ai/dsh-llm';
+import type { BoardModelCatalog } from './task-board-engine.js';
+
+interface CatalogModel {
+  id: string;
+  reasoning?: { efforts: Array<{ id: string }>; defaultEffort?: string };
+}
+
+export interface DesignModelRoute {
+  provider: string;
+  models: Map<string, CatalogModel>;
+  defaultEffort?: string;
+  defaultModel?: string;
+}
+
+export interface DesignModelSource {
+  catalog: (signal: AbortSignal) => Promise<BoardModelCatalog | undefined>;
+  llm: Pick<LlmRuntime, 'stream'>;
+  attachments?: AttachmentStore;
+}
+
+export function studioModels(catalog: BoardModelCatalog | undefined, origin: string, editorId: string, token: string) {
+  const routes = new Map<string, DesignModelRoute>();
+  const configs = [];
+  const fallback = catalog?.default;
+  for (const group of catalog?.groups ?? []) {
+    const models = new Map(group.models.filter(model => model.id.trim() === model.id && model.id.length > 0 &&
+      [...model.id].length <= 256 && !/[\r\n]/.test(model.id)).map(model => [model.id, model]));
+    if (!models.size) continue;
+    const primary = fallback?.provider === group.id && models.has(fallback.model);
+    const modelIds = [...models.keys()];
+    if (primary) modelIds.splice(0, modelIds.length, fallback.model, ...modelIds.filter(model => model !== fallback.model));
+    for (let offset = 0; offset < modelIds.length; offset += 64) {
+      const batch = modelIds.slice(offset, offset + 64);
+      const id = `dsh-${createHash('sha256').update(JSON.stringify([group.id, offset])).digest('hex').slice(0, 24)}`;
+      const isDefault = primary && offset === 0;
+      const config = {
+        id, preset: 'custom', display_name: group.name || group.id, kind: 'openai-compat', enabled: true,
+        api_key: token, base_url: `${origin}/${editorId}/${id}`, model: batch[0],
+        ...(batch.length > 1 ? { models: batch } : {}),
+      };
+      routes.set(id, {
+        provider: group.id,
+        models: new Map(batch.map(model => [model, models.get(model)!])),
+        defaultEffort: isDefault ? fallback.reasoningEffort : undefined,
+        defaultModel: isDefault ? fallback.model : undefined,
+      });
+      if (isDefault) configs.unshift(config);
+      else configs.push(config);
+    }
+  }
+  return { routes, configs };
+}
+
+export class DesignModelInputError extends Error {}
+
+type UserContent = Extract<GenerateOptions['messages'][number], { role: 'user' }>['content'];
+const mediaTypes = new Set<ImageMediaType>(['image/png', 'image/jpeg', 'image/webp', 'image/gif']);
+
+async function userContent(content: unknown, attachments: AttachmentStore | undefined, signal: AbortSignal): Promise<UserContent> {
+  if (typeof content === 'string') return [{ type: 'text', text: content }];
+  if (!Array.isArray(content)) throw new DesignModelInputError('Invalid user content');
+  const parts: Array<UserContent[number]> = [];
+  for (const block of content) {
+    signal.throwIfAborted();
+    if (block?.type === 'text' && typeof block.text === 'string') {
+      parts.push({ type: 'text', text: block.text });
+      continue;
+    }
+    const url = block?.type === 'image_url' && block.image_url?.url;
+    const image = typeof url === 'string' ? /^data:(image\/[a-z+]+);base64,([A-Za-z0-9+/]+={0,2})$/.exec(url) : null;
+    const mediaType = image?.[1] as ImageMediaType;
+    if (!image || !mediaTypes.has(mediaType) || !attachments) throw new DesignModelInputError('Invalid or unavailable image attachment');
+    const attachment = await attachments.saveImage({ data: Buffer.from(image[2], 'base64'), mediaType });
+    parts.push({ type: 'image', attachment });
+  }
+  return parts;
+}
+
+export async function streamDesignModel(
+  body: Buffer, route: DesignModelRoute, source: DesignModelSource, res: ServerResponse, signal: AbortSignal,
+): Promise<void> {
+  let input;
+  try { input = JSON.parse(body.toString('utf8')); }
+  catch { throw new DesignModelInputError('Invalid model request'); }
+  const model = route.models.get(input?.model);
+  if (!model || input.stream !== true || !Array.isArray(input.messages) || input.messages.length > 400) {
+    throw new DesignModelInputError('Invalid model request');
+  }
+  const system: string[] = [];
+  const messages: GenerateOptions['messages'] = [];
+  for (const message of input.messages) {
+    if (message?.role === 'system' && typeof message.content === 'string') system.push(message.content);
+    else if (message?.role === 'assistant' && typeof message.content === 'string') {
+      messages.push(createAssistantMessage({ content: [{ type: 'text', text: message.content }], source: { provider: route.provider, model: model.id } }));
+    } else if (message?.role === 'user') {
+      messages.push({ role: 'user', content: await userContent(message.content, source.attachments, signal) });
+    } else throw new DesignModelInputError('Invalid model message');
+  }
+  if (!messages.length) throw new DesignModelInputError('Missing model messages');
+  const efforts = model.reasoning?.efforts.map(effort => effort.id) ?? [];
+  const requested = input.thinking?.type === 'disabled' ? ['off', 'none'].find(effort => efforts.includes(effort)) : input.reasoning_effort;
+  const effort = efforts.includes(requested) ? requested : route.defaultModel === model.id ? route.defaultEffort : undefined;
+  const outputLimit = Number.isInteger(input.max_tokens) && input.max_tokens > 0 ? input.max_tokens : undefined;
+  const temperature = typeof input.temperature === 'number' && input.temperature >= 0 && input.temperature <= 2 ? input.temperature : undefined;
+  const emit = async (payload: unknown) => {
+    signal.throwIfAborted();
+    if (!res.headersSent) res.writeHead(200, { 'content-type': 'text/event-stream', 'cache-control': 'no-store' });
+    if (!res.write(`data: ${JSON.stringify(payload)}\n\n`)) await once(res, 'drain', { signal });
+  };
+  for await (const chunk of source.llm.stream({
+    provider: route.provider, model: model.id, messages, system: system.join('\n\n'),
+    maxTokens: outputLimit, temperature, reasoningEffort: effort ? ReasoningEffortId(effort) : undefined, signal,
+  })) {
+    if (chunk.type === 'text-delta') await emit({ choices: [{ delta: { content: chunk.text } }] });
+    if (chunk.type === 'reasoning-delta') await emit({ choices: [{ delta: { reasoning_content: chunk.text } }] });
+    if (chunk.type === 'finish') {
+      if (chunk.reason.kind !== 'stop' && chunk.reason.kind !== 'max-tokens') throw new Error('Unexpected model finish');
+      await emit({ choices: [{ finish_reason: chunk.reason.kind === 'max-tokens' ? 'length' : 'stop' }] });
+      res.end();
+      return;
+    }
+  }
+  throw new Error('Missing model finish');
+}
